# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# postinstall ile node_modules'ten kopyalanir (scripts/copy-zxing-wasm.mjs)
/public/zxing_reader.wasm

# Göç öncesi güvenlik yedekleri — makinede kalır, depoya girmez.
yedekler/

# Ticari veri (urun listeleri, komisyon, hakedis) — depo herkese acik
veri/ozel/

# Ölçüm çıktıları — GERÇEK TİCARİ VERİ. Depo herkese açık; asla commit edilmez.
raporlar/

# Geçici ölçüm betikleri — MEKANİZMA, ALIŞKANLIK DEĞİL.
# 24.08.2026'da bir ölçüm betiği commit'e sızdı: silme komutu yazma
# komutuyla aynı zincirde koşunca dosya doğmadan çalıştı. "Bir dahaki sefere
# silerim" bir niyettir; niyet unutulur, .gitignore unutmaz.
# BENIOKU.md İSTİSNA — klasörün kendisi depoda görünsün diye.
/scripts/tmp/*
!/scripts/tmp/BENIOKU.md
