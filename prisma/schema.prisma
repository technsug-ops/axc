// ============================================================================
//  SELLIORA — FAZ 1 ŞEMASI
// ----------------------------------------------------------------------------
//  Kapsam : Ürün/Varyant · Kanal & Kanal-SKU · Alım · Stok defteri · Kredi kartı
//  Kapsam dışı (sonraki fazlar): satış/kâr, iade, hakediş, gider/muhasebe.
//
//  Bağlantı adresi prisma.config.ts içinden okunur (kaynak: .env -> DATABASE_URL).
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ============================================================================
//  ENUM'LAR
// ============================================================================

/// Desteklenen para birimleri. Yeni birim eklemek migration ister.
enum Currency {
  TRY
  EUR
}

enum FeeScope {
  PER_SALE // sipariş başına bir kez alınır (kalem sayısından bağımsız)
  PER_ITEM // her satış kalemi için ayrı alınır

  /// PAKET BAŞINA — ölçüldü 20.08.2026, TY panelinden.
  ///
  /// Sipariş bölünüp iki kargoyla gönderilince Trendyol'un ₺13,19 platform
  /// hizmet bedeli İKİ KEZ alınıyor (`11361665302`: −26,38 = 2 × 13,19).
  /// Motor bunu sipariş başına sabit sayıyordu; bölünmüş her siparişte
  /// kesinti eksik, kâr ŞİŞKİN hesaplanıyordu.
  ///
  /// ⚠ `basis` DEĞİL `scope`: `basis` "nasıl hesaplanır" (yüzde/sabit),
  /// `scope` "kaç kez alınır" der. Paket sayısı ikincinin sorusudur.
  /// `FIXED_PER_PACKAGE` diye bir basis eklemek iki boyutu tek enuma
  /// sıkıştırır ve "paket başına yüzde" gerektiğinde çıkmaz sokak olurdu.
  PER_PACKAGE // her paket için ayrı alınır (bölünmüş sipariş)
}

enum FeeBasis {
  SALE_AMOUNT // tutarın yüzdesi
  COMMISSION_AMOUNT // komisyon tutarının yüzdesi (komisyon KDV'si)
  FIXED // sabit tutar
}

/// Kâr hesaplanabildi mi, hesaplanamadıysa NEDEN.
/// Sıfır varsaymak yasak — hesaplanamayan kâr ekranda "hesaplanamadı" yazar.
/// Bir düzeltme nedeninin hangi YÖNDE seçilebileceği.
///
/// 16.08.2026 kullanıcı bulgusu: "stoğa ekle" derken listede "Fire",
/// "Hasar / kırılma", "Kayıp" görünüyordu. Yoktan mal belirmesini "fire"
/// diye kaydetmek anlamsızdır ve zararsız da değil — rapor o kaydı
/// "fire kazancı" satırına yazar, ekran kendi kendini yalanlar.
enum DuzeltmeYonu {
  /// Yalnız stoktan düşerken seçilebilir (fire, hasar, kayıp).
  EKSI
  /// Yalnız stoğa eklerken seçilebilir (kayıp bulundu, fazla gönderim).
  ARTI
  /// İki yönde de anlamlı (sayım farkı, diğer).
  HER_IKISI
}

enum ProfitStatus {
  CALCULATED
  NO_COST // FIFO partisinde birim maliyet yok
  CURRENCY_MISMATCH // maliyet ve satış para birimi farklı; kur çevrilmez
  RULE_MISSING // komisyon oranı veya kargo tarifesi bulunamadı
}

/// İade türü — operasyonun üç gerçek senaryosu.
enum ReturnType {
  UNDELIVERED // teslim edilemeden döndü; gidiş kargosu zaten yandı
  NORMAL // müşteri aldı, iade etti; dönüş kargosu satıcıda
  /// GEÇ İTİRAZ (rolü netleşti 13.08.2026, kullanıcı kararı).
  /// İade İŞLENDİKTEN SONRA kazanılan itiraz: mal zaten gelmiş ve kayda
  /// girmişken pazaryeri sonradan satıcı lehine karar verir; ürün müşteride
  /// kalır, stoğa GİRMEZ.
  /// Mal GELMEDEN açılan itiraz artık burada YAŞAMAZ — o, bildirimin
  /// (ReturnNotice) bir dalıdır ve kabul edilirse Return hiç doğmaz.
  DISPUTED
}

/// MÜŞTERİNİN İADE GEREKÇESİ — bildirim anında bilinen tek şey.
/// Kâr etkisi yok; bu bir sınıflandırmadır ve operasyon kalitesi ölçer.
enum ReturnReason {
  DEGISIM // yedek ürün ayrılır, gelince gönderilir
  DEGISIM_KUSURLU // aynı + müşteri kusur iddia ediyor
  CALISMIYOR // gelince servise/analize gider, hüküm sonra
  CAYMA // gelince muayene; sağlamsa onay
  KULLANILMIS_ITIRAZ // kullanılmış çıktı; pazaryerine itiraz edildi
  /// ── PAZARYERİNİN KENDİ LİSTESİNDEN (docs/iade-sureci.md §3) ──
  /// 23.08.2026: Trendyol müşteri uygulamasının "İade Sebebi Seçiniz"
  /// listesi ölçüldü ve bizim 7 değerimizin çoğunun karşılığı çıkmadı;
  /// hepsi `DIGER`e düşüyordu. En kötüsü, `DIGER`e düşenler tam da PARASI
  /// GERİ ALINABİLİR olanlardı (hasar → kargo tazminatı, eksik parça →
  /// tedarikçi). Aşağıdakiler eklendi; ESKİLER SİLİNMEDİ (mevcut kayıtlar
  /// onlara bağlı ve `KULLANILMIS_ITIRAZ` gibi bazıları bizim
  /// sınıflandırmamız, müşterinin sebebi değil).
  BEDEN_BUYUK // "Bedeni/Ebatı Büyük Geldi"
  BEDEN_KUCUK // "Bedeni/Ebatı Küçük Geldi"
  DAHA_UCUZ // "Daha iyi bir fiyat mevcut"
  PARCA_EKSIK // "Ürünümün parçası/aksesuarı eksik gönderildi"
  HASARLI // ürün hasarlı — kargo şirketine tazmin başvurusu yolu açar
  BOS_PAKET // boş paket geldi — kesinlikle itiraz edilir
  URUN_EKSIK // adetli siparişte eksik geldi
  /// BİZİM HATAMIZ — A satıldı, B gönderildi. Dönen varyant satılandan
  /// FARKLIDIR. Kırılımda ayrı sayılır: bu bir DEPO HATASI metriğidir,
  /// müşteri caymasıyla aynı kefeye konmaz.
  YANLIS_URUN
  DIGER
}

/// BİLDİRİMİN AŞAMASI. Return'ün profitStatus'ü ile karıştırılmaz —
/// bildirimde kâr hesabı YOKTUR, bu yüzden "hesaplanamayan" sayacına düşmez.
/// Pazaryerinin sekmeleriyle eşleşir — bkz. docs/iade-sureci.md §1.
enum NoticeStatus {
  BEKLENIYOR // "Talep Oluşturulan": müşteri iade açtı, mal henüz kargoda değil
  KARGOYA_VERILDI // "Kargoya Verilen": mal yolda. ARA ADIM, atlanabilir.
  MAL_GELDI // "Aksiyon Bekleyen": mal elimizde, onay/red kararı bekleniyor
  ITIRAZ_ACILDI // "İhtilaflı": reddettik, kanıt yüklendi
  ITIRAZ_INCELEMEDE // "İhtilaflı" (alt hâl): pazaryeri inceliyor
  ANALIZ // "Analiz": pazaryeri servise göndermemizi istedi — 28 gün
  /// "Reddedilen": İTİRAZIMIZ KABUL EDİLDİ, satıcı haklı bulundu.
  ///
  /// ⚠ 23.08.2026'DA GEREKÇE DÜZELTİLDİ. Burada eskiden şu yazıyordu:
  /// _"LEHE — ürün müşteride kalır, iade İŞLENMEZ."_ Bu OLGUSAL OLARAK
  /// YANLIŞTI: ürün "Aksiyon Bekleyen" aşamasında bize gelmişti ve
  /// elimizde duruyor. Doğrusu — kargo kodu alınır ve ürün **2 iş günü
  /// içinde müşteriye geri gönderilir**.
  ///
  /// Para tarafı zaten doğruydu (`Return` doğmuyor, ölçüldü); yanlış olan
  /// gerekçeydi ve o yüzden FİZİKSEL İŞ görünmüyordu: sistem "kapandı"
  /// derken depoda gönderilmeyi bekleyen ürün vardı.
  ///
  /// ⚠ ENUM ADI BİLEREK KORUNDU: "itirazımız kabul edildi" doğru bir
  /// cümledir; yanlış olan yorumdu. Yeniden adlandırma veri göçü demekti
  /// ve karşılığı yalnız isim güzelliği olurdu. Ekranda görünen etiket
  /// sözlükten geliyor ve orada "Reddedilen — geri gönderilecek" yazar.
  ITIRAZ_KABUL
  ITIRAZ_RED // İtirazımız reddedildi → "Onaylanan"a gider, Return doğar
  /// "Askıda İadeler": iade NORMAL AKIŞTAN ÇIKMIŞ. Kargo problemi, statü
  /// uyumsuzluğu, pazaryerinin ek incelemesi… Bizim yapacağımız bir işlem
  /// olduğu anlamına GELMEZ (o "Aksiyon Bekleyen"dir); burada kalan iade
  /// ürünün ve bedelin kapanmasını geciktirir. Arıza kutusudur, boş kalmalı.
  ASKIDA
  KAPANDI // iade işlendi (Return doğdu) ya da lehe kapandı
  IPTAL // müşteri vazgeçti, mal hiç gelmedi
}

/// Satıcı iadeyi REDDEDERKEN seçtiği gerekçe (docs/iade-sureci.md §4).
/// ⚠ `ReturnReason` ile karıştırılmaz: o MÜŞTERİNİN sebebi, bu BİZİM
/// itirazımız. İkisi ayrı listelerdir ve ayrı sorulara cevap verir.
enum NoticeObjectionReason {
  KULLANILMIS // Müşteriden gelen ürün kullanılmış
  IADE_YANLIS // Müşteriden gelen iade yanlış
  HIJYEN // Müşteriden gelen ürün hijyen ürünü
  ANALIZ_TALEBI // İadeyi analize alacağım — TALEPTİR, kararı pazaryeri verir
  DEGISIM // Değişim yapacağım — geri giden YENİ üründür, kargo her yerde bizde
  HASARLI // Müşteriden gelen ürün hasarlı
  EKSIK // Müşteriden gelen ürün eksik
  KUSURSUZ_GONDERILDI // Siparişi kusurlu göndermedim
}

/// Analiz (servis) dalının sonucu — docs/iade-sureci.md §6.
enum AnalysisResult {
  TAMIR_EDILDI
  DEGISIM_YAPILDI
  SORUN_BULUNAMADI
}

enum ChannelType {
  MARKETPLACE // Trendyol, Hepsiburada, Amazon...
  OWN_STORE // kendi siteniz
}

/// Stok defteri hareket tipleri.
/// Not: SALE_OUT / RETURN_IN gibi tipler satış fazında eklenecek.
enum StockMovementType {
  INITIAL // açılış / devir stoğu
  PURCHASE_IN // alımdan giriş
  SALE_OUT // satıştan çıkış (quantityDelta negatif)
  RETURN_IN // iadeden giriş — SAĞLAM gelen mal stoğa döner
  EXCHANGE_OUT // değişimde giden yeni ürün (satış geliri YOK, maliyet var)
  ADJUSTMENT // manuel düzeltme (işareti quantityDelta belirler)
  COUNT_CORRECTION // sayım farkı
  /// SATIŞ İPTALİ — mal HİÇ ÇIKMADI, stok geri döner.
  ///
  /// `RETURN_IN` KULLANILMADI: o "müşteri aldı, iade etti" demektir ve
  /// hareket tipleri kullanıcıya ETİKETLE gösteriliyor (bkz. etiketler.ts).
  /// İptali iade diye yazsaydık ekranda "iadeden giriş" görünür, kullanıcı
  /// hiç yaşanmamış bir iade arardı. İki farklı olay aynı görünmemeli.
  SALE_CANCEL_IN
}

/// Bir satışın neden iptal edildiği.
///
/// Kullanıcı taksonomisi 17.08.2026. İki taraf ayrı tutuluyor çünkü
/// sorumluluk farklı: müşteri iptali talebi, mağaza iptali OPERASYONU
/// ilgilendirir. "Stok yok" sayısı artıyorsa stok yönetiminde sorun var
/// demektir; bunu "müşteri vazgeçti" ile aynı kefeye koymak sinyali
/// öldürürdü.
enum SatisIptalSebebi {
  MUSTERI_FIYAT // müşteri: fiyattan dolayı vazgeçti
  MUSTERI_VAZGECTI // müşteri: sebepsiz vazgeçti
  MAGAZA_STOK_YOK // mağaza: stok mevcut değil
  MAGAZA_KOTU_NIYET // mağaza: kötü niyetli alım
  MAGAZA_DIGER // mağaza: diğer — AÇIKLAMA ZORUNLU
}

/// Tedarikçiden tazminat talebinin hangi aşamada olduğu.
enum CompensationStatus {
  OPEN // hasar kaydedildi, talep henüz açılmadı
  CLAIMED // tedarikçiye bildirildi
  ACCEPTED // kabul edildi, ödeme/iade bekleniyor
  REJECTED // reddedildi
  SETTLED // kapandı (para geldi ya da mal değişti)
}

/// Kart ekstresi ödeme kaydının KAYNAĞI.
/// Geçmiş veri paketi AYNI tabloyu kullanır (mimar kararı 15.08.2026):
/// ayrı tasarlanırsa iki farklı "ekstre" kavramı doğar ve biri diğerini
/// gölgeler.
/// Bir kaydın NEREDEN geldiği.
///
/// Adı önce `KartOdemeKaynagi`ydi; geçmiş ekstreler de aynı damgayı
/// taşıyınca ad dar kaldı ve `VeriKaynagi` yapıldı (16.08.2026).
/// SQL DEĞİŞMEDİ: Prisma enum adı istemci tarafı bir tiptir, MySQL sütunu
/// zaten `ENUM('TURETILEN','GECMIS_EXCEL','ELLE')` olarak satır içi duruyor.
/// Boş migration üretildiği ölçülerek doğrulandı.
enum VeriKaynagi {
  TURETILEN // canlı: ekstre borcu alımlardan türetildi
  GECMIS_EXCEL // geçmiş beyan: Excel'den aktarıldı
  ELLE // kullanıcı doğrudan girdi
}

/// GİDER NASIL ÖDENDİ (25.08.2026).
///
/// ⚠ NİYE SAKLANIYOR — SAKLAMAMANIN BEDELİ ÖLÇÜLDÜ: form üç seçenek
/// gösterip seçimi saklamasaydı, düzenlemeye girildiğinde "Havale" seçilmiş
/// bir gider ekranda başka türlü görünürdü. Ekranın yanlış bir şey
/// göstermesi, bir sütundan pahalıdır.
///
/// ⚠ `null` = BELİRTİLMEDİ ve bu bir DEĞER DEĞİL, BİLGİ YOKLUĞUDUR.
/// 25.08.2026 öncesi girilen giderlerde alan boştur; ekran "belirtilmedi"
/// der. "Nakit" VARSAYILMAZ — sistemin bilmediği bir şeyi uydurması,
/// bilmediğini söylemesinden kötüdür. (Geri doldurma bilinçli olarak YOK.)
///
/// ⚠ BU ALAN HİÇBİR HESABA GİRMEZ — bilinçli. Kart borcu ve nakit takvimi
/// `creditCardId`den yürür; bu alan yalnız BEYAN ve GÖRÜNÜM taşır. İleride
/// "nakit mi bankadan mı" raporu istenirse o gün hesaba bağlanır.
enum OdemeYontemi {
  NAKIT // kasadan nakit
  HAVALE // banka havalesi/EFT
  KART // kredi kartı — `creditCardId` ile birlikte anlamlıdır
}

enum PurchaseStatus {
  DRAFT // taslak
  ORDERED // sipariş verildi, henüz hiçbir kalem gelmedi
  PARTIALLY_RECEIVED // kalemlerin bir kısmı geldi (parçalı teslim)
  RECEIVED // tüm kalemler tamamlandı (sağlam + hasarlı = beklenen)
  CANCELLED // iptal
}

// ============================================================================
//  ÜRÜN & VARYANT
// ----------------------------------------------------------------------------
//  KURAL: Her ürünün EN AZ bir varyantı vardır.
//  Beden/renk gibi seçeneği olmayan ürünler için de tek bir "varsayılan
//  varyant" (isDefault = true) açılır. Böylece stok/SKU/barkod her zaman
//  aynı seviyede durur ve tüm sorgular tek bir yapı üzerinden çalışır.
//
//  UYGULAMA DÜZEYİNDE GARANTİ EDİLECEK: bir üründe isDefault = true olan
//  tam olarak bir varyant bulunur. (MySQL'de kısmi unique index olmadığı
//  için veritabanı seviyesinde zorlanamıyor.)
// ============================================================================

model Product {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  brand       String?

  /// Sadece arayüz ipucu: false ise ürünün tek (varsayılan) varyantı vardır.
  hasVariants Boolean @default(false)
  isActive    Boolean @default(true)

  /// KDV kategorisi. Boşsa varsayılan orana düşer ve ekranda
  /// "kategori atanmamış" uyarısı görünür.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// KDV İSTİSNASI — doluysa kategori oranını EZER. Normalde boştur.
  /// Çözüm sırası: bu alan > kategori oranı > varsayılan %20.
  vatRateOverride Decimal? @db.Decimal(5, 2)

  /// Kargo desisi. ÜRÜN seviyesinde tutulur: varyantlar farklı olabilir
  /// ama desi değişmez (karar 09.08.2026).
  desi Decimal? @db.Decimal(9, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]

  @@index([name])
  @@index([isActive])
  @@index([categoryId])
}

// ============================================================================
//  KATEGORİ VE KDV
// ----------------------------------------------------------------------------
//  KDV oranı ürün ürün elle girilmez; üründen kategoriye, kategoriden orana
//  gidilir. Kategoriler ve oranlar AYARLANABİLİR VERİDİR (sabit kod değil) —
//  bu yüzden çok-kiracılı yapıda her müşteri kendi setini kullanabilir.
//  Türkiye varsayılanları seed ile gelir: Genel %20, İndirimli %10,
//  Süper İndirimli %1.
// ============================================================================

model Category {
  id String @id @default(cuid())

  name String @unique

  /// KİMLİK KISALTMASI — otomatik SKU'nun ilk parçası (OYU-LG-260707-01).
  /// Boş olabilir: mevcut kayıtlara kod türetilirken ÇAKIŞMA çıkarsa
  /// sessizce çözülmez, boş bırakılır ve ekran kullanıcıya sorar.
  /// Kod boşken o kategorideki ürün için SKU önerisi üretilemez.
  code String? @unique

  /// KDV oranı YÜZDE olarak: 20, 10, 1
  vatRate Decimal @db.Decimal(5, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

/// Stok, SKU ve barkodun tutulduğu seviye. Ürün seviyesinde stok YOKTUR.
model ProductVariant {
  komisyonTarifeKalemleri KomisyonTarifeKalemi[]

  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Sistem içi ana stok kodu. Kanal SKU'larından bağımsızdır.
  sku     String  @unique
  /// Üreticinin barkodu (EAN/GTIN). Bizim ürettiğimiz bir kod değildir.
  barcode String? @unique

  /// FİRMA SKU — firmanın fiziğe yapıştırdığı etiket kodu.
  /// Arayüzde "Firma SKU" olarak görünür.
  /// ChannelSku (pazaryeri stok kodu) ile hiçbir ilgisi yoktur, bağımsızdır.
  /// ZORUNLU ve benzersiz: etiketsiz varyant kaydı açılamaz.
  companySku String @unique

  /// Gösterim adı: "M / Kırmızı". Varsayılan varyantta boş bırakılabilir.
  name      String?
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  /// Depodaki raf konumu (opsiyonel).
  /// ŞU AN: varyant başına TEK konum — bilerek basit tutuldu.
  /// İLERİDE çoklu konum gerekirse: bu iki alan kaldırılır, araya
  /// VariantLocation (variantId, locationId, quantity) ara tablosu konur.
  /// Location ve ProductVariant modellerinin geri kalanı değişmez.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options            VariantOption[]
  channelSkus        ChannelSku[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  returnItems        ReturnItem[]    @relation("IadeVaryanti")
  exchangeItems      ReturnItem[]    @relation("DegisimVaryanti")
  ayrilanBildirimler ReturnNotice[]  @relation("AyrilanVaryant")
  /// 6. senaryoda YANLIŞ GİDEN (geri dönen) ürün olarak geçtiği bildirimler.
  /// Ayrılan ile aynı şey DEĞİL: ayrılan gönderilecek, dönen geri gelen.
  donenBildirimler   ReturnNotice[]  @relation("DonenVaryant")
  stockMovements     StockMovement[]

  @@index([productId])
  @@index([isActive])
  @@index([locationId])
}

/// Varyant seçenekleri (Beden=M, Renk=Kırmızı).
/// Serbest ad/değer çifti olduğu için ileride "Materyal", "Voltaj" gibi yeni
/// seçenek türleri şema değişikliği gerektirmez.
model VariantOption {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  name  String // "Beden"
  value String // "M"

  @@unique([variantId, name])
  @@index([name, value])
}

// ============================================================================
//  DEPO KONUMU (RAF)
// ----------------------------------------------------------------------------
//  Amaç: ev mini deposundaki raf düzenini sisteme almak ve toplama (picking)
//  ekranında "bu ürün hangi rafta" bilgisini gösterebilmek.
//
//  Şu an tek fiziksel depo var, o yüzden ayrı bir Warehouse modeli YOK.
//  Model çoklu konuma zaten hazır: her raf bir Location satırıdır.
//  İkinci bir depo gerekirse iki seçenek var, ikisi de mevcut veriyi bozmaz:
//    a) kodlamayla ayırmak  -> "EV-A-03-2", "OFIS-B-01-1"
//    b) Location'a nullable parentId self-relation ekleyip hiyerarşi kurmak
//       (Depo > Koridor > Raf > Göz)
// ============================================================================

model Location {
  id String @id @default(cuid())

  /// Raf kodu: "A-03-2". Etiketlerde ve toplama listesinde bu görünür.
  code String  @unique
  /// İsteğe bağlı okunabilir ad: "Salon dolabı üst raf".
  name String?

  description String? @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants       ProductVariant[]
  returnItems    ReturnItem[]
  stockMovements StockMovement[]

  @@index([isActive])
}

// ============================================================================
//  KANAL & KANAL-SKU
// ----------------------------------------------------------------------------
//  Channel        = platform (Trendyol)
//  ChannelAccount = o platformdaki BİR hesap/mağaza  -> çok hesap desteği
//  ChannelSku     = bir varyantın belirli bir hesaptaki stok kodu
// ============================================================================

model Channel {
  id   String      @id @default(cuid())
  code String      @unique // TRENDYOL, HEPSIBURADA, AMAZON_DE
  name String
  type ChannelType @default(MARKETPLACE)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// İtirazlı iadede ürün müşteriye geri gönderilirken kargoyu satıcı
  /// öder mi? Trendyol: hayır · Hepsiburada: evet.
  disputedReshipPaidBySeller Boolean @default(false)

  accounts       ChannelAccount[]
  fees           ChannelFee[]
  cargoTariffs   CargoTariff[]
  penaltyTariffs PenaltyTariff[]
}

// ============================================================================
//  CEZA TARİFESİ
// ----------------------------------------------------------------------------
//  Müşteri iadeyi "kusurlu/yanlış ürün" gerekçesiyle açar ve satıcının
//  savunması REDDEDİLİRSE pazaryeri sipariş tutarına göre ceza keser.
//
//  Tutar ELLE girilir; bu tablo yalnızca ÖNERİ üretir (kargo tarifesi
//  kalıbı). Oran kuralları kanala göre değişken ve kısmen belirsiz olduğu
//  için dayatma yapılmaz.
//
//  Kademe okuma: orderAmountUpTo >= sipariş tutarı olan EN KÜÇÜK satır.
//  Kademesi olmayan tutarda öneri çıkmaz, ekran "elle girin" der.
// ============================================================================

model PenaltyTariff {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Bu tutara KADAR olan siparişler bu kademeye girer.
  orderAmountUpTo Decimal @db.Decimal(18, 4)

  amount   Decimal  @db.Decimal(18, 4)
  currency Currency @default(TRY)

  effectiveFrom DateTime

  createdAt DateTime @default(now())

  @@unique([channelId, orderAmountUpTo, effectiveFrom])
  @@index([channelId, orderAmountUpTo])
}

// ============================================================================
//  KANAL KESİNTİ KURALLARI — SABİT KOD DEĞİL, VERİ
// ----------------------------------------------------------------------------
//  Komisyonun KENDİSİ burada değildir: oran ürün×pazaryeri bazında değişir ve
//  ChannelSku'da tutulur. Burada komisyon ÜZERİNE gelen ve kanala özgü olan
//  kesintiler var.
//
//  Seed (teyitli 09.08.2026):
//    Hepsiburada  KOMISYON_KDV   PER_ITEM  COMMISSION_AMOUNT  %20
//    Hepsiburada  ODEME_GIDERI   PER_SALE  SALE_AMOUNT        %0,8
//    Hepsiburada  HIZMET_BEDELI  PER_SALE  FIXED              12,60 TRY
//    Trendyol     SABIT_GIDER    PER_SALE  FIXED              13,19 TRY
// ============================================================================

model ChannelFee {
  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Bilinen kesintilerde sözlükten Türkçe adı çözülen kod.
  /// Müşterinin eklediği özel kesintilerde `name` doldurulur ve o kullanılır —
  /// böylece hem i18n kuralı hem SaaS ayarlanabilirliği korunur.
  code String
  name String?

  scope FeeScope
  basis FeeBasis

  /// basis yüzde ise oran, sabit ise tutar dolu olur.
  ///
  /// ORAN BİRİMİ — TEK STANDART: yüzde olarak saklanır.
  ///   %0,8  -> 0.80000
  ///   %20   -> 20.00000
  /// Motor kullanmadan önce 100'e böler. Bu belirsizlik 10 kat hata
  /// sınıfının ta kendisidir; kar:dogrula her iki kesinti tipinde
  /// birim testi yapar.
  rate     Decimal?  @db.Decimal(9, 5)
  amount   Decimal?  @db.Decimal(18, 4)
  currency Currency?

  /// Kural ne zamandan itibaren geçerli. Eski satışlar snapshot ile korunur.
  validFrom DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channelId, code, validFrom])
  @@index([channelId, isActive])
}

// ============================================================================
//  KARGO TARİFESİ
// ----------------------------------------------------------------------------
//  Kargo firması SATIŞTA SEÇİLİR; varsayılan yoktur. Ücret kanal + firma +
//  desi üçlüsünden okunur. Tarife tutarları KDV HARİÇTİR — üstüne %20 eklenir
//  (kaynak tabloların başlığı bunu açıkça yazıyor).
//
//  Ürünün desisi kesirliyse YUKARI yuvarlanır (kargo firmalarının pratiği).
// ============================================================================

model CargoCarrier {
  id   String @id @default(cuid())
  code String @unique // ARAS, YURTICI, HEPSIJET...
  name String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tariffs CargoTariff[]
  sales   Sale[]

  /// Kargo şirketinden istenen tazminatlar (iade kargoda kaybolduğunda).
  compensations Compensation[]
}

model CargoTariff {
  id        String       @id @default(cuid())
  channelId String
  channel   Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  carrierId String
  carrier   CargoCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  /// Tam desi. Kaynak tablolar 1'er adım ilerliyor (0,1,2,...).
  desi Int

  /// KDV HARİÇ tutar.
  amount   Decimal  @db.Decimal(18, 4)
  currency Currency @default(TRY)

  /// Tarifenin yürürlük tarihi (kaynak sayfa başlığından).
  effectiveFrom DateTime

  createdAt DateTime @default(now())

  @@unique([channelId, carrierId, desi, effectiveFrom])
  @@index([channelId, carrierId, desi])
}

/// Aynı kanalda birden fazla mağaza/hesap açılabilir.
model ChannelAccount {
  komisyonTarifeleri KomisyonTarifesi[]

  id        String  @id @default(cuid())
  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Restrict)

  code       String // kanal içinde benzersiz kısa kod
  name       String // "TR Ana Mağaza"
  externalId String? // pazaryerindeki satıcı/mağaza kimliği

  /// Hesabın çalıştığı para birimi (TR mağazası TRY, DE mağazası EUR).
  defaultCurrency Currency

  /// ÖDEME VADESİ (gün) — satıştan kaç gün sonra para hesaba geçer.
  /// Beklenen hakediş tarihi = satış tarihi + bu gün sayısı.
  /// KANAL HESABI seviyesinde tutuluyor (kullanıcı kararı 10.08.2026):
  /// aynı pazaryerinde açılan ikinci mağazanın anlaşması farklı olabilir.
  /// Boşsa o hesabın satışları için beklenen tarih ÜRETİLMEZ — tahmin
  /// edilmiş bir tarih göstermektense boş bırakılır.
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * HESABIN ROLÜ — ALIŞ mı SATIŞ mı?
   * 12.08.2026'da ortaya çıktı: kullanıcı arbitraj yaptığı için AYNI
   * pazaryerinde iki tür hesabı var.
   * ALIŞ  — kampanya döneminde mal ALDIĞI kişisel hesaplar (hesap başına
   * alım limiti olduğu için birden çok: s.ahmet, Seda, Eymen...)
   * SATIŞ — mal SATTIĞI mağaza hesabı (AXCALI)
   * Ölçüm: 13 hesabın 8'i alış, 2'si satış.
   * Formda TEK SEÇİM yapılır (radyo, varsayılansız): bir hesap ya alış ya
   * satış hesabıdır — kullanıcı kararı 12.08.2026, "ikisi de" NORMAL BİR
   * DURUM DEĞİLDİR. İki ayrı bayrak tutulmasının tek sebebi, geçmişte
   * yanlışlıkla ikisi birden kullanılmış hesabı GÖRÜNÜR kılabilmek —
   * o hesap ekranda amber uyarı alır ve düzeltmeye çağırır.
   * İKİSİ DE FALSE = ROL SEÇİLMEMİŞ. Böyle hesap hiçbir forma listelenmez;
   * listede "rol seçilmedi" rozeti taşır. Sessizce bir tarafa atamak,
   * kullanıcının hiç görmediği bir karar vermek olurdu.
   */
  alisIcin  Boolean @default(false)
  satisIcin Boolean @default(false)

  /// YALNIZ SATIŞ HESABI İÇİN ANLAMLI: alış hesabında vade diye bir şey yok.
  payoutDays Int?

  /// Vade İŞ GÜNÜ cinsinden mi? Trendyol 28 İŞ GÜNÜ öder (≈41 takvim günü);
  /// takvim günü sayılsaydı beklenen tarih 13 gün yanılırdı.
  /// Varsayılan false = takvim günü.
  payoutDaysAreBusinessDays Boolean @default(false)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channelSkus     ChannelSku[]
  purchases       Purchase[]
  sales           Sale[]
  settlements     Settlement[]
  settlementItems SettlementItem[]

  @@unique([channelId, code])
  @@index([channelId])
}

/// Bir varyantın belirli bir kanal hesabındaki karşılığı.
model ChannelSku {
  id               String         @id @default(cuid())
  channelAccountId String
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  /// Kanalda kullanılan stok kodu (bizim sku ile aynı olmak zorunda değil).
  channelSku        String
  /// Pazaryerindeki ürün/listing kimliği.
  externalListingId String?

  /// KOMİSYON ORANI (%) — ürün×pazaryeri bazında farklıdır ve HAFTALIK
  /// değişir (Trendyol Salı, Hepsiburada Çarşamba günceller). Bu yüzden
  /// ürün kartında değil, kanal SKU'sunda tutulur. Satış formunda buradaki
  /// oran ÖNERİLİR ama değiştirilebilir; satışa snapshot'lanan değer
  /// formdaki son değerdir.
  /// ORAN BİRİMİ: yüzde olarak saklanır (%12 -> 12.00). Motor 100'e böler.
  commissionRate      Decimal?  @db.Decimal(5, 2)
  commissionUpdatedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channelAccountId, channelSku])
  @@unique([channelAccountId, variantId])
  @@index([variantId])
}

// ============================================================================
//  KREDİ KARTI
// ----------------------------------------------------------------------------
//  GÜVENLİK: Burada BİLEREK tam kart numarası, CVV ve son kullanma tarihi
//  tutulmuyor. Bunları saklamak PCI-DSS kapsamına girer ve ciddi yükümlülük
//  doğurur. Amaç "hangi kartla ödendi" bilgisini taşımak; son 4 hane yeter.
// ============================================================================

model CreditCard {
  id         String  @id @default(cuid())
  label      String // "Garanti Bonus ***4321"
  bankName   String?
  last4      String  @db.Char(4)
  holderName String?

  /// Kartın ekstre para birimi.
  currency Currency

  creditLimitAmount   Decimal?  @db.Decimal(18, 4)
  creditLimitCurrency Currency?

  /// Hesap kesim / son ödeme günü — ayın günü olarak (1-31).
  /// "Faizsiz dönemi en uzun kart" seçiminin girdisi bunlardır:
  /// alım tarihinden sonraki ilk kesim günü ne kadar uzaksa alım o kadar geç
  /// ekstreye düşer, ödeme de dueDay kadar daha ertelenir.
  /// Hesaplama sonraki fazda servis katmanına yazılacak; şema sadece veriyi taşır.
  /// Opsiyonel: değeri girilmemiş kartlar bu sıralamaya alınmaz.
  statementDay Int? // hesap kesim günü (1-31)
  dueDay       Int? // son ödeme günü (1-31)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases       Purchase[]
  /**
   * KARTLA ÖDENEN GİDERLER (25.08.2026).
   * ⚠ Kullanıcı: _"giderleri ve vergileri de kartla ödüyorum."_ Bu bağ
   * olmadan kart borcu YALNIZ alımlardan hesaplanıyordu ve kartla ödenen
   * her gider borçta görünmüyordu — kart borcu ve nakit takvimi o kadar
   * eksik gösteriyordu.
   */
  giderler        Expense[]
  odemeler        KartOdeme[]
  gecmisEkstreler GecmisEkstre[]

  @@index([isActive])
}

/// KART EKSTRE ÖDEMESİ — bir ekstre dönemi için bir ödeme kaydı.
///
/// NEDEN VAR: sistem kart borcunu alımlardan TÜRETİYOR ama "ödendi" kaydı
/// yoktu; nakit takvimi kart tarafını ve gecikmişi gösteremiyordu. Bu tablo
/// nakit takviminin eksik yarısını kapatır.
///
/// LEDGER DEĞİŞMEZLİĞİ: kayıt SİLİNMEZ. Yanlışsa TERS KAYITLA düzeltilir —
/// StockMovement ilkesinin aynısı. `updatedAt` yalnız not düzeltmesi
/// içindir; tutarlar değişmez.
///
/// MÜKERRER ÖDEME KORUMASI DB KISITI DEĞİL, ÖNİZLEMEDİR (mimar kararı
/// 15.08.2026). `@@unique([cardId, donem])` KONULMADI çünkü kısmi ödeme ve
/// ters kayıt aynı döneme düşer. Kaza, kaydetmeden önce "bu ekstreye daha
/// önce ₺X ödenmiş, kalan ₺Y — yine de ekle?" uyarısıyla yakalanır.
model KartOdeme {
  id String @id @default(cuid())

  cardId String
  card   CreditCard @relation(fields: [cardId], references: [id], onDelete: Restrict)

  /// EKSTRE DÖNEMİ — ayın 1'i olarak saklanır (2026-08-01 = "Ağustos
  /// ekstresi"). Kesim günü karta bağlı ve değişebilir; buraya
  /// KOPYALANMAZ, `CreditCard.statementDay`den okunur.
  donem DateTime

  /// Sistemin alımlardan TÜRETTİĞİ ekstre borcu (`lib/kart-borcu.ts`),
  /// kayıt anında SNAPSHOT'lanır: alım sonradan düzeltilse bile o gün hangi
  /// borç üzerinden ödeme yapıldığı değişmez (kâr snapshot'larıyla aynı ilke).
  ekstreBorcu Decimal @db.Decimal(18, 4)

  /// ÖDENEN ANA BORÇ. Ön-dolu gelir (= ekstreBorcu) ama kullanıcı
  /// DÜZELTEBİLİR — banka farklı kesmiş olabilir.
  ///
  /// KALAN ALANI YOK, TÜRETİLİR: ekstreBorcu − odenenAnaBorc. Saklansaydı
  /// iki rakam birbirinden sapabilir ve panel "borç 1.000, ödenen 400,
  /// kalan 700" gibi imkânsız bir şey yazabilirdi.
  odenenAnaBorc Decimal @db.Decimal(18, 4)

  odemeTarihi DateTime

  /// GECİKME FAİZİ — İKİ GİRİŞ YOLU:
  ///   (a) `faizOrani` (günlük %) + `faizGun` → sistem ÇARPAR
  ///   (b) `faizTutar` doğrudan elle
  /// SİSTEM ORANI ÜRETMEZ: bankaya, karta ve güne göre değişir; uydurulursa
  /// panel yanlış olur. Kullanıcı girer, sistem yalnız çarpar.
  faizOrani Decimal? @db.Decimal(6, 4)
  faizGun   Int?

  /// Hesaplanan ya da elle girilen faiz. SIFIR SESSİZCE VARSAYILMAZ:
  /// gecikme yoksa kullanıcı açıkça 0 bırakır.
  faizTutar Decimal @default(0) @db.Decimal(18, 4)

  /// EUR kapısı açık ama kullanılmadıkça TRY varsayılır (mimar kararı
  /// 15.08.2026) — çok para birimi hâlâ ertelenmiş büyüme paketi.
  currency Currency @default(TRY)

  /// FAİZİN GİDER KARŞILIĞI. Faiz → "finansman gideri / kart gecikme faizi"
  /// olarak O DÖNEMİN kârını düşürür. ANA BORÇ ÖDEMESİ KÂRI ETKİLEMEZ —
  /// maliyet alımda zaten sayıldı. İki rakam ayrı; toplanmaz, karışmaz.
  faizGiderId String?  @unique
  faizGider   Expense? @relation(fields: [faizGiderId], references: [id], onDelete: SetNull)

  kaynak VeriKaynagi @default(TURETILEN)

  /// TERS KAYIT — düzeltmenin tek yolu. Yanlış kayıt ters işaretli bir
  /// kayıtla nötrlenir; ikisi de defterde kalır.
  isReversal Boolean    @default(false)
  reversesId String?    @unique
  reverses   KartOdeme? @relation("KartOdemeTers", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy KartOdeme? @relation("KartOdemeTers")

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId, donem])
  @@index([odemeTarihi])
  @@index([kaynak])
}

// ============================================================================
//  ALIM (SATIN ALMA)
// ----------------------------------------------------------------------------
//  PARA BİRİMİ KURALI: Her parasal alanın hemen yanında kendi para birimi
//  alanı vardır. Mal bedeli EUR, yurt içi kargo TRY olabilir; şema bunu
//  varsayım yapmadan taşır.
// ============================================================================

model Purchase {
  id     String         @id @default(cuid())
  code   String         @unique // ALM-2026-0001
  status PurchaseStatus @default(DRAFT)

  /// TEDARİKÇİ — 10.08.2026'da kayda bağlandı (Faz 3).
  /// `supplierName` SİLİNMEDİ: eski kayıtların yazıldığı hâli ve içe
  /// aktarma izi olarak duruyor. Migration mevcut benzersiz adları
  /// Supplier'a eşledi; formda artık kayıtlı tedarikçi seçilir.
  supplierName String?
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// TEDARİKÇİDEKİ SİPARİŞ NUMARASI — dış dünyanın kimliği.
  /// `code` bizim kaydımızın kimliğidir ve sistem üretir; bu alan ise
  /// tedarikçiye/pazaryerine "şu siparişte sorun var" derken söylediğiniz
  /// numaradır ("439 744 418 4"). İkisi ayrı sorunun cevabı, karıştırılmaz.
  /// Benzersiz DEĞİL: aynı sipariş numarası birden çok alıma bölünebilir.
  supplierOrderNo String?

  /// ── İÇE AKTARMA İZİ (K55, 26.08.2026) ─────────────────────────────────
  ///
  /// TOPLU YAZIMIN KİMLİĞİ. Bir alış içe aktarma koşumunun ürettiği bütün
  /// alımlar aynı değeri taşır; geri alma bu alanla yapılır.
  ///
  /// ⚠ NİYE `supplierOrderNo` KULLANILMADI — merdiven ölçüldü: o alan
  /// TEDARİKÇİNİN sipariş numarasıdır ve elle girilen kayıtlarda da dolu
  /// (canlıda 355/385). Parti kimliği olarak kullanmak iki farklı anlamı
  /// tek kolona koyar ve o kolonu okuyan her sorguyu kirletirdi.
  /// `note` serbest metni de yetmez: geri alma bu alanı SORGULAR, yani
  /// ihtiyaç geriye bakmak değil YAPI. _(Anayasa: şema değişikliği en
  /// pahalı çözümdür — ilk üç basamak denendi ve tutmadı.)_
  ///
  /// ⚠ ELLE GİRİLEN ALIMDA NULL KALIR ve bu ayrımın kendisi bilgidir.
  importBatch String?

  /// SATIRIN NEREDEN GELDİĞİ — bugün tek değer: 'alis-excel'.
  ///
  /// ⚠ Tek değerli bir alan bugün gereksiz görünür; ama ikinci kaynak
  /// (tedarikçi API'si, toptancı dökümü) doğduğu gün geçmişe dönüp
  /// "bunlar nereden gelmişti" sorusunun cevabı OLMAZ. Kaynak raporda
  /// değil KAYITTA durur — satış tarafında verilen kararın aynısı.
  importKaynak String?

  purchasedAt DateTime
  receivedAt  DateTime?

  /// Alımın yapıldığı kanal hesabı (hesap başına alım limiti olduğu için önemli).
  channelAccountId String?
  channelAccount   ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)

  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  /// Taksit sayısı. 1 = tek çekim.
  installmentCount Int @default(1)

  /// Mal bedeli özeti — OPSİYONEL.
  /// Gerçek toplam her zaman kalemlerden (PurchaseItem) para birimi bazında
  /// hesaplanır; bir alımda TRY ve EUR kalemler bir arada olabilir ve
  /// birbirine ÇEVRİLMEZ. Bu alanlar sadece tek para birimli alımlarda
  /// özet olarak doldurulur.
  goodsAmount   Decimal?  @db.Decimal(18, 4)
  goodsCurrency Currency?

  shippingAmount   Decimal?  @db.Decimal(18, 4)
  shippingCurrency Currency?

  taxAmount   Decimal?  @db.Decimal(18, 4)
  taxCurrency Currency?

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseItem[]

  @@index([purchasedAt])
  @@index([status])
  @@index([creditCardId])
  @@index([channelAccountId])
  @@index([supplierOrderNo])
  /// Geri alma tüm partiyi bu alandan bulacak — dizin şart.
  @@index([importBatch])
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  /// Beklenen (sipariş edilen) adet.
  quantity Int

  /// HASARLI GELEN ADET — stoğa GİRMEZ, bu yüzden ledger'da karşılığı yoktur
  /// ve burada sayaç olarak tutulur. Satıcıya iade ve tazminat süreci
  /// sonraki fazlarda; şimdilik sadece sayı ve not saklanır.
  damagedQuantity Int     @default(0)
  damageNote      String? @db.Text

  /// Bu kalemdeki hasar için açılan tazminat talepleri (Faz 3).
  compensations Compensation[]

  /// NOT: "gelen sağlam" adedi BİLEREK kolon olarak tutulmuyor.
  /// Bu kaleme ait PURCHASE_IN hareketlerinin toplamından türetilir
  /// (src/lib/stok.ts). Tek doğruluk kaynağı ledger'dır.
  unitCostAmount   Decimal  @db.Decimal(18, 4)
  unitCostCurrency Currency

  stockMovements StockMovement[]

  @@index([purchaseId])
  @@index([variantId])
}

// ============================================================================
//  STOK DEFTERİ (LEDGER)
// ----------------------------------------------------------------------------
//  Varyantta "mevcut stok" kolonu YOKTUR. Stok = hareketlerin toplamıdır:
//      SELECT SUM(quantityDelta) FROM StockMovement WHERE variantId = ?
//
//  Kayıtlar değiştirilmez (updatedAt bilerek yok). Hatalı bir hareket
//  silinmez; ters işaretli bir ADJUSTMENT ile düzeltilir. Böylece geçmiş
//  her zaman yeniden üretilebilir kalır.
//
//  Depo/lokasyon kırılımı kapsam dışı. İleride eklenirse bu modele bir
//  warehouseId kolonu gelir; mevcut yapı bozulmaz.
// ============================================================================

model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  type StockMovementType

  /// Pozitif = giriş, negatif = çıkış. Asla 0 olmamalı.
  quantityDelta Int

  occurredAt DateTime @default(now())

  /// Hareketin kaynağı. Alım kaynaklı hareketlerde dolu olur.
  purchaseItemId String?
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  /// Satış kaynaklı hareketlerde dolu olur (SALE_OUT).
  saleItemId String?
  saleItem   SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  /// İade kaynaklı hareketlerde dolu olur (RETURN_IN, EXCHANGE_OUT).
  returnItemId String?
  returnItem   ReturnItem? @relation(fields: [returnItemId], references: [id], onDelete: SetNull)

  /// FIFO İZİ — bu ÇIKIŞ hangi GİRİŞ partisinden düştü.
  /// Parti = pozitif quantityDelta'lı bir hareket (INITIAL, PURCHASE_IN,
  /// pozitif ADJUSTMENT/COUNT_CORRECTION). Bir satış kalemi birden fazla
  /// partiden düşebilir; o zaman parti başına AYRI bir SALE_OUT yazılır.
  ///
  /// Partide kalan miktar KOLON OLARAK TUTULMAZ; `quantityDelta` eksi
  /// tüketimlerin toplamı diye türetilir (bkz. src/lib/stok.ts). Tek
  /// doğruluk kaynağı ledger'dır — PurchaseItem'daki "gelen sağlam"
  /// kararının aynısı.
  sourceMovementId String?
  sourceMovement   StockMovement?  @relation("FifoParti", fields: [sourceMovementId], references: [id], onDelete: Restrict)
  tuketimler       StockMovement[] @relation("FifoParti")

  /// Malın hangi rafa girdiği (mal kabulde seçilir).
  /// Varyantın güncel konumundan bağımsız olarak KAYIT ANINDAKİ rafı tutar;
  /// ürün sonradan başka rafa taşınsa bile geçmiş bozulmaz.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// Giriş anındaki birim maliyet — ileride stok değerlemesi için saklanır.
  unitCostAmount   Decimal?  @db.Decimal(18, 4)
  unitCostCurrency Currency?

  /// KİM YAPTI — çok kullanıcılı yapıyla doldu (Faz 4).
  /// GEÇMİŞ HAREKETLER null KALIR ve ekranda "sistem öncesi" görünür;
  /// geriye doldurmak, olmayan bir bilgiyi uydurmak olurdu.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// ELLE DÜZELTME NEDENİ — yalnız ADJUSTMENT/COUNT_CORRECTION tipinde
  /// dolu olur. Satış, alım ve iade hareketlerinde boştur.
  adjustmentReasonId String?
  adjustmentReason   StockAdjustmentReason? @relation(fields: [adjustmentReasonId], references: [id], onDelete: Restrict)

  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([variantId, occurredAt])
  @@index([type])
  @@index([purchaseItemId])
  @@index([saleItemId])
  @@index([returnItemId])
  @@index([sourceMovementId])
  @@index([locationId])
  @@index([adjustmentReasonId])
  @@index([userId])
}

// ============================================================================
//  SATIŞ
// ----------------------------------------------------------------------------
//  Alım tarafıyla bilerek simetrik: Sale/SaleItem ↔ Purchase/PurchaseItem.
//  Bir pazaryeri siparişi tek numara altında birden çok ürün taşır; bu yüzden
//  satış çok kalemlidir.
//
//  Satılan malın MALİYETİ burada tutulmaz — FIFO ile hangi partiden düştüyse
//  o partinin maliyeti ilgili SALE_OUT hareketine yazılır. Kâr motoru (sonraki
//  aşama) maliyeti oradan okur.
// ============================================================================

model Sale {
  id String @id @default(cuid())

  /// Pazaryerindeki sipariş numarası. Girilmesi zorunlu değil; girilirse
  /// benzersizdir (MySQL'de NULL'lar tekrarlanabilir, bu bilinçli).
  code String? @unique

  /// GÖNDERİ (TAKİP) NUMARASI — kargo/pazaryeri kodu, K41① 24.08.2026.
  ///
  /// Sipariş no ile AYNI KALIP: boş bırakılabilir, GİRİLİRSE BENZERSİZ.
  /// Benzersizlik şart — aynı kod iki satışta olsaydı okutma İKİ sonuç
  /// döndürür ve hangisinin doğru olduğu bilinemezdi.
  ///
  /// ⚠ NULLABLE @unique: MySQL birden çok NULL'a izin verir; `code` ile
  /// birebir aynı davranış, yeni bir kural değil.
  ///
  /// ⚠ GERİ DOLDURULMAZ. Kod pazaryerinde/kargoda SONRADAN oluşuyor;
  /// var olan 125 satışta boş kalması doğrudur — uydurulamaz.
  shipmentCode String? @unique

  /// Satış her zaman bir kanal hesabından yapılır — hangi pazaryerinin
  /// hangi mağazasından satıldığı kâr ve hakediş hesabının temelidir.
  channelAccountId String
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Restrict)

  soldAt DateTime
  note   String?  @db.Text

  /// ── İPTAL ──────────────────────────────────────────────────────────────
  /// İPTAL EDİLDİ Mİ SORUSUNUN TEK KAYNAĞI `iptalTarihi`dir.
  ///
  /// Ayrı bir `iptalEdildiMi` boolean'ı EKLENMEDİ: iki alan iki gerçek
  /// demektir ve bir gün biri doluyken diğeri boş kalır ("iptal ama tarihi
  /// yok" ya da "tarihi var ama iptal değil"). Bu depoda aynı ilke zaten
  /// yazılı — kalan TÜRETİLİR, saklanmaz.
  ///
  /// ⚠ İPTAL EDİLEN SATIŞ CİROYA, NET'E VE HAKEDİŞ BEKLENTİSİNE GİRMEZ.
  /// İade gibi "düşülmez", HİÇ DOĞMAMIŞ sayılır: mal çıkmadı, komisyon
  /// kesilmedi, kargo yanmadı. Süzgeç tek yerde tanımlıdır ve bir bekçi
  /// süzgeçsiz satış sorgusu kalmadığını denetler.
  iptalTarihi DateTime?
  iptalSebebi SatisIptalSebebi?
  /// MAGAZA_DIGER seçildiğinde ZORUNLU — "diğer" açıklamasız bir kayıt,
  /// üç ay sonra cevabı olmayan bir soruya dönüşür.
  iptalNotu   String?           @db.Text
  /// Kim iptal etti. Kullanıcı silinmez (pasife alınır) — Restrict.
  iptalEdenId String?
  iptalEden   User?             @relation("SatisIptalEden", fields: [iptalEdenId], references: [id], onDelete: Restrict)

  // --- KARGO (satışta seçilir, snapshot'lanır) ---
  cargoCarrierId String?
  cargoCarrier   CargoCarrier? @relation(fields: [cargoCarrierId], references: [id], onDelete: SetNull)

  /// Pakete giren toplam desi. Form varsayılanı Σ(ürün.desi × adet);
  /// fiili tartım farklı çıkabildiği için elle değiştirilebilir.
  cargoDesi Decimal? @db.Decimal(9, 3)

  /// KAÇ PAKETLE GÖNDERİLDİ — ölçüldü 20.08.2026 (TY paneli).
  ///
  /// Sipariş bölünürse pazaryeri PAKET BAŞINA hizmet bedeli alıyor
  /// (`11361665302`: 2 paket → −26,38 = 2 × 13,19). `PER_PACKAGE`
  /// kapsamlı kesintiler bu sayıyla çarpılır.
  ///
  /// ⚠ `@default(1)` — geri doldurma YOK. Bölünmemiş sipariş zaten tek
  /// pakettir; mevcut bütün satırlar olduğu gibi doğru kalır.
  ///
  /// ⚠ TÜRETİLEMEDİĞİ İÇİN SÜTUN: kargo/tarife oranıyla türetme denendi,
  /// 49 satışın hiçbiri eşiği geçmedi ve TY kargoyu ciro yüzdesi olarak
  /// gösteriyor — türetme tahmin olurdu ve sessizce yanlış kesinti
  /// üretirdi. Serbest metin de yetmez: bu, NET-2'nin GİRDİSİ.
  paketSayisi Int @default(1)

  /// Tarifeden okunan KDV HARİÇ kargo ücreti (snapshot).
  cargoAmount   Decimal?  @db.Decimal(18, 4)
  cargoCurrency Currency?

  /**
   * KARGOYA VERİLDİ — elle işaretlenen operasyonel durum.
   * _Kullanıcı kararı 14.08.2026: "kargoya teslim edilen ürünü manuel
   * girebilirim."_
   * BOŞ = henüz kargoya verilmedi (bekliyor). DOLU = o gün kargoya verildi.
   * Panel "kargoya verilen / bekleyen" sayısını bu alandan üretir; başka
   * hiçbir yerden türetilemiyordu — kargo firması, desi ve ücret satışta
   * seçiliyor ama "verildi" bilgisi hiç tutulmuyordu.
   * LEDGER DEĞİL, DURUM: stok defteri gibi dokunulmaz bir kayıt değildir;
   * yanlış işaretlenirse temizlenebilir. Bu yüzden ADJUSTMENT benzeri bir
   * ters kayıt gerekmez — kâr hesabına da girmez.
   * İŞ TARİHİ (UTC gece yarısı, Europe/Istanbul günü): saat taşımaz, çünkü
   * "hangi gün kargoya verildi" sorusunun cevabı gündür.
   * TEK PAKET VARSAYIMI: bir satış = bir sevkiyat. Kısmi sevkiyat (bir
   * siparişin iki koliyle gitmesi) gerekirse bu alan kalkar, yerine
   * Shipment tablosu gelir; çağıran taraflar o gün değişir. Bugün ~30
   * paket/gün için ayrı tablo yönetmek gereksiz karmaşıklıktı
   * (kullanıcı kararı 14.08.2026).
   */
  shippedAt DateTime?

  // --- SATIŞ SEVİYESİ KÂR ---
  /// Σ kalem NET − sipariş başına kesintiler (hizmet bedeli, sabit gider,
  /// kargo). Bu kesintiler kalemlere bölünmez.
  net1Amount     Decimal?      @db.Decimal(18, 4)
  net2Amount     Decimal?      @db.Decimal(18, 4)
  profitCurrency Currency?
  profitStatus   ProfitStatus?
  calculatedAt   DateTime?

  /// ── İÇE AKTARMA İZİ (A3-③, 26.08.2026) ────────────────────────────────
  ///
  /// TOPLU YAZIMIN KİMLİĞİ. Bir içe aktarma koşumunun ürettiği bütün
  /// satırlar aynı değeri taşır; geri alma bu alanla yapılır.
  ///
  /// ⚠ GERİ ALMA SİLME DEĞİL İŞARETLEMEDİR: parti `iptalTarihi` ile
  /// işaretlenir. Silme, `SaleItem` Cascade + `StockMovement` SetNull
  /// yüzünden stok hareketlerini sahipsiz bırakırdı (bkz. anayasa →
  /// "silme kararı: ilke ihlali değil, veri bozan işlem").
  ///
  /// ⚠ ELLE GİRİLEN SATIŞTA NULL KALIR — ve bu ayrımın kendisi bilgidir:
  /// "bu satırı insan mı yazdı, içe aktarma mı" sorusunun cevabı.
  importBatch String?

  /// SATIRIN NEREDEN GELDİĞİ — 'enumerasyon' | 'hakediş çaprazı'.
  ///
  /// ⚠ KAYNAK RAPORDA DEĞİL KAYITTA DURUR (kullanıcı şartı 26.08.2026).
  /// Rapor silinir, kayıt kalır; üç ay sonra "bu satış nereden geldi"
  /// sorusu ancak kayıttan cevaplanabilir.
  ///
  /// ⚠ AYRIM BOŞ BİR ETİKET DEĞİL: enumerasyon TY'nin tarih penceresi
  /// listesinden geliyor ve o liste ölçülmüş biçimde kayıt DÜŞÜRÜYOR
  /// (aynı sorgu iki koşumda 497 ↔ 560). "Hakediş çaprazı" ile gelen
  /// satır, enumerasyonun kaçırdığı ve BAŞKA bir kaynaktan bilindiği
  /// için tek tek çekilmiş satırdır — güven derecesi aynı değildir.
  importKaynak String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           SaleItem[]
  fees            SaleFee[]
  returns         Return[]
  returnNotices   ReturnNotice[]
  settlementItems SettlementItem[]

  @@index([channelAccountId])
  @@index([soldAt])
  @@index([cargoCarrierId])
  /// İptal süzgeci her satış sorgusunda çalışacak — dizin şart.
  @@index([iptalTarihi])
  /// Geri alma bu alandan tüm partiyi bulacak — dizin şart.
  @@index([importBatch])
}

model SaleItem {
  /// ⚠ ORANIN HANGİ PENCEREDEN GELDİĞİ — mimar maddesi 18.08.2026.
  ///
  /// Satışa komisyon oranı SNAPSHOT'lanıyor ve kâr onunla hesaplanıyor;
  /// bu doğru. Ama bugün "o snapshot BAYAT MIYDI" sorusu CEVAPLANAMIYOR:
  /// oran geçmişi tutulmuyor (yükleme `commissionRate`i üstüne yazıyor,
  /// ne geçmiş tablosu ne denetim kaydı var — ölçüldü 18.08.2026).
  ///
  /// Bu alan oranı bir TARİFE PENCERESİNE bağlar; soru gelecekte
  /// ölçülebilir olur. Geçmiş satışlarda NULL kalır — geri doldurma YOK,
  /// çünkü hangi pencereden geldiği zaten bilinmiyor ve uydurmak
  /// geçmişi tahrif etmek olurdu.
  commissionTarifeId String?
  commissionTarife   KomisyonTarifesi? @relation(fields: [commissionTarifeId], references: [id], onDelete: SetNull)

  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity Int

  /// Birim SATIŞ fiyatı. Maliyet burada değil, SALE_OUT hareketlerindedir.
  unitPriceAmount   Decimal  @db.Decimal(18, 4)
  unitPriceCurrency Currency

  // --- SATIŞ ANINDA ÇÖZÜLEN ORANLAR (snapshot) ---
  /// Ürün istisnası > kategori oranı > varsayılan %20 ile çözülür.
  vatRate Decimal? @db.Decimal(5, 2)

  /// Kanal SKU'sundan önerilen, formda değiştirilebilen komisyon oranı.
  commissionRate Decimal? @db.Decimal(5, 2)

  // --- KALEM SEVİYESİ KÂR ---
  /// satış − komisyon (+KDV'si) − maliyet − stopaj − KDV payı.
  /// SİPARİŞ BAŞINA kesintiler buraya GİRMEZ; onlar satış seviyesindedir.
  net1Amount   Decimal?      @db.Decimal(18, 4)
  net2Amount   Decimal?      @db.Decimal(18, 4)
  profitStatus ProfitStatus?

  /// Bu kalemin FIFO düşümleri. Kalem 5 adetse ve iki partiden düştüyse
  /// burada iki hareket olur (3 + 2). Kaydedilen adetlerin toplamı her
  /// zaman `quantity` kadardır.
  stockMovements StockMovement[]
  fees           SaleFee[]
  returnItems    ReturnItem[]

  @@index([saleId])
  @@index([variantId])
}

// ============================================================================
//  KÂR KESİNTİ KALEMLERİ — SNAPSHOT
// ----------------------------------------------------------------------------
//  Detay ekranındaki "kesintiler kalem kalem" listesi buradan beslenir.
//  Tek tabloda iki seviye:
//    saleItemId DOLU  -> kalem kesintisi  (komisyon, maliyet, stopaj, KDV)
//    saleItemId BOŞ   -> SİPARİŞ kesintisi (hizmet bedeli, sabit gider, kargo)
//
//  Snapshot'tır: oran veya tarife sonradan değişse eski satışın dökümü
//  değişmez. Yeniden hesaplama ayrı ve bilinçli bir eylemdir.
// ============================================================================

model SaleFee {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  saleItemId String?
  saleItem   SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  /// Sözlükten Türkçe adı çözülen kod: KOMISYON, KOMISYON_KDV, ODEME_GIDERI,
  /// HIZMET_BEDELI, SABIT_GIDER, KARGO, KARGO_KDV, STOPAJ, MALIYET,
  /// ODENECEK_KDV
  code String
  name String?

  amount   Decimal  @db.Decimal(18, 4)
  currency Currency

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([saleItemId])
}

// ============================================================================
//  İADE
// ----------------------------------------------------------------------------
//  ORİJİNAL SATIŞ SNAPSHOT'I SİLİNMEZ. İade etkisi AYRI satırlarla eklenir;
//  satış detayı "orijinal kâr + iade etkisi = iade sonrası net" gösterir.
//  Ledger felsefesinin kâr tarafındaki karşılığı budur.
//
//  ReturnFee neden SaleFee'den AYRI:
//  Kâr yeniden hesaplama `SaleFee`yi silip yeniden yazıyor
//  (src/lib/kar-yeniden.ts). İade satırları oraya konsaydı her yeniden
//  hesapta sessizce uçardı. Ayrı tablo bunu YAPISAL olarak engelliyor.
//
//  KESİNTİ İADESİ (teyitli 09.08.2026):
//    GERİ GELİR  : komisyon, komisyon KDV'si, %0,8 ödeme gideri, stopaj
//                  (kısmi iadede hepsi ADET ORANINDA)
//    GERİ GELMEZ : 12,60 hizmet bedeli, 13,19 sabit gider, gidiş kargosu
// ============================================================================

model Return {
  id String @id @default(cuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  /// Pazaryerindeki iade/talep numarası — opsiyonel.
  code String?

  returnType ReturnType
  occurredAt DateTime
  note       String?    @db.Text

  /// Dönüş kargosu (müşteri → satıcı), KDV DAHİL. Satıcı gideri.
  returnCargoAmount Decimal? @db.Decimal(18, 4)

  /// Yeniden gönderim (satıcı → müşteri), KDV DAHİL.
  /// İtirazlı iadede kanal politikasına bağlı; değişimde her zaman satıcıda.
  reshipCargoAmount Decimal? @db.Decimal(18, 4)

  cargoCurrency Currency?

  /// CEZA — "kusurlu/yanlış ürün" itirazı reddedilirse pazaryeri keser.
  /// Tarifeden ÖNERİLİR ama elle girilir (PenaltyTariff).
  penaltyAmount   Decimal?  @db.Decimal(18, 4)
  penaltyCurrency Currency?
  penaltyNote     String?   @db.Text

  /// DEĞİŞİM ÜRÜNÜNÜN MÜŞTERİYE TESLİM TARİHİ.
  ///
  /// VADE BURADAN YENİDEN BAŞLAR (kullanıcı kararı 13.08.2026): değişimde
  /// pazaryeri siparişi açık tutar ama hakediş, ORİJİNAL satıştan değil
  /// yerine giden ürünün tesliminden sayılır. Ölçüldü: `beklenenVade`
  /// bugün `Sale.soldAt` kullanıyor, yani değişimli satışta beklenen para
  /// tarihi olduğundan ERKEN çıkıyor.
  ///
  /// Boşsa eski davranış sürer (satış tarihi). Kalem değil KAYIT
  /// seviyesinde: ayda ~1 iade hacminde kalem bazında tarih tutmak
  /// karşılığı olmayan bir karmaşıklık olurdu.
  ///
  /// NOT: hakediş dosyası bir vade taşıyorsa RAPOR KAZANIR; bu alan
  /// yalnızca rapora düşmemiş satışların TAHMİNİNİ düzeltir.
  exchangeDeliveredAt DateTime?

  /// KİM GİRDİ — 13.08.2026'da eklendi.
  /// StockMovement.userId ile AYNI desen: geçmiş kayıtlar null kalır ve
  /// ekranda "sistem öncesi" görünür; geriye doldurmak olmayan bir bilgiyi
  /// uydurmak olurdu.
  ///
  /// NEDEN AYRI ALAN — stok hareketinden okunamıyor: tamamı hasarlı iadede
  /// RETURN_IN hareketi HİÇ OLUŞMUYOR (canlı vakada doğrulandı), yani izin
  /// en çok gerektiği yerde iz kalmıyordu. "Bu 1.799 TL'lik hasarı kim
  /// işaretledi" sorusunun cevabı olmalı.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// İade SONRASI net — orijinal snapshot'a dokunmadan hesaplanır.
  net1Amount     Decimal?      @db.Decimal(18, 4)
  net2Amount     Decimal?      @db.Decimal(18, 4)
  profitCurrency Currency?
  profitStatus   ProfitStatus?
  calculatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ReturnItem[]
  fees  ReturnFee[]

  /// Bu iadeyi doğuran bildirim — VARSA. Bildirimsiz doğrudan iade girme
  /// yolu AÇIK kalır: kapıya habersiz gelen koli gerçeği.
  notice ReturnNotice?

  @@index([saleId])
  @@index([occurredAt])
  @@index([userId])
}

/// ============================================================================
///  İADE BİLDİRİMİ (RMA) — İKİ AŞAMALI AKIŞIN BİRİNCİ AŞAMASI
/// ----------------------------------------------------------------------------
///  NEDEN Return'DEN AYRI BİR VARLIK:
///  Bildirim geldiğinde mal henüz yolda. Sağlam mı hasarlı mı, hatta gelecek
///  mi belli değil — yani KÂR ETKİSİ HESAPLANAMAZ. Bunu Return'e yazsaydık
///  net1/net2 null kalır ve kayıt panelin/raporun "kârı hesaplanamayan"
///  sayacına düşerdi; o uyarı gerçek sorunları gösteriyor, gürültülenemez.
///
///  KURAL NET: bildirim kayıt değil, KAYDIN ÖNCÜSÜDÜR.
///  `Return` = hükmü verilmiş iade.
///
///  Faz 4'te pazaryeri API'si iade bildirimlerini otomatik getirdiğinde
///  taşıyıcı bu tablodur; akış değişmez, yalnız kaynağı otomatikleşir.
/// ============================================================================
model ReturnNotice {
  id String @id @default(cuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  /// Pazaryerindeki talep numarası — dış dünyanın kimliği.
  code String?

  noticedAt DateTime
  reason    ReturnReason
  status    NoticeStatus @default(BEKLENIYOR)
  note      String?      @db.Text

  /**
   * PAZARYERİNİN BEYAN ETTİĞİ OTOMATİK ONAY TARİHİ.
   * ⚠ HESAPLANMAZ, KAYDEDİLİR. Trendyol ekranda "Otomatik Onaya Kalan
   * Süre: 19 gün 07:42" yazıyor; yani tarihi O söylüyor. Kuralı (kaç
   * günden, hangi andan) ÖLÇEMEDİK — iki kayıt farklı toplam verdi
   * (~34,6 ve ~15,8 gün, bkz. docs/iade-sureci.md §8.1). Bilmediğimiz bir
   * kuraldan tarih türetmek, sistemin takip etmediği şey hakkında iddia
   * kurmak olurdu; onun yerine pazaryerinin söylediği tarih yazılır.
   * Boş olması NORMALDİR: kapanmış bildirimde sayaç yoktur.
   */
  otomatikOnayTarihi DateTime?

  /**
   * BİZİM YÜKÜMLÜLÜĞÜMÜZÜN son tarihi — `otomatikOnayTarihi`nden AYRI şey.
   * · "Reddedilen"de → ürünü geri kargolama son tarihi (2 iş günü)
   * · "Analiz"de     → servisten dönüp kargolanma son tarihi (28 gün)
   * ⚠ İKİSİ TEK SÜTUNA SIKIŞTIRILMADI çünkü farklı şeyler: biri ONLARIN ne
   * zaman otomatik onaylayacağı (olgu), öteki BİZİM ne zamana kadar
   * yapmamız gerektiği (yükümlülük). Aynı anda ikisi de anlamlı olabilir.
   */
  islemSonTarihi DateTime?

  /// Reddederken seçilen gerekçe. Yalnız itiraz dalında dolar.
  itirazGerekcesi NoticeObjectionReason?

  /**
   * Analizden dönen sonuç.
   * ⚠ AYNI ZAMANDA "GELİŞ YOLU" İŞARETİDİR. "Reddedilen" durumuna ÜÇ ayrı
   * yoldan gelinir ve üçünde kargoyu ödeyen taraf farklıdır
   * (docs/iade-sureci.md §5). Ayrı bir "geliş yolu" sütunu AÇILMADI, çünkü
   * türetilebiliyor:
   * `analizSonucu` dolu        → analiz sonrası (kargo her yerde bizde)
   * `itirazGerekcesi = DEGISIM`→ değişim        (kargo her yerde bizde)
   * ikisi de değil             → satıcı haklı   (TY'de bize yansımaz)
   */
  analizSonucu AnalysisResult?

  /// İade kargosunun takip kodu — KİMLİK KODUDUR, listede tık-kopyala durur.
  iadeKargoKodu String?

  /// İade kargosunun desisi. Maliyet tarifeden bununla çözülür; elle girilen
  /// tutar yine ezer (kargo firmasından farklı gelmiş olabilir).
  iadeDesi Decimal? @db.Decimal(10, 2)

  /// DEĞİŞİM İÇİN AYRILAN ÜRÜN (senaryo 1, 2, 6).
  /// FİZİKSEL STOK VE FIFO'YA DOKUNMAZ — bu bir defter kaydı değil, niyet
  /// beyanıdır. Stok ekranındaki "ayrılmış N adet" rozeti açık
  /// bildirimlerden ANLIK toplanır; bildirim kapanınca kendiliğinden düşer.
  /// "Rezervasyonu serbest bırakmayı unutma" diye bir iş doğmaz.
  reservedVariantId String?
  reservedVariant   ProductVariant? @relation("AyrilanVaryant", fields: [reservedVariantId], references: [id], onDelete: SetNull)
  reservedQuantity  Int             @default(0)

  /**
   * DÖNEN (YANLIŞ GİDEN) ÜRÜN — yalnız 6. senaryoda dolu.
   * _Kullanıcı onayı 14.08.2026._
   * `reservedVariantId` ile KARIŞTIRILMAZ, ikisi ayrı şeyi anlatır:
   * reserved  → GÖNDERECEĞİMİZ ürün (stok ekranındaki "ayrılmış" rozeti)
   * returned  → GERİ GELEN ürün (defter düzeltmesinin öznesi)
   * 6. senaryoda gönderilen A, dönen B'dir; tek alanla anlatılamıyordu ve
   * iade formu dönen ürünü ön-dolu getiremiyordu.
   * Boş kalması NORMALDİR: diğer gerekçelerde dönen mal satılan malın
   * kendisidir, ayrıca yazmak tekrar olurdu.
   */
  returnedVariantId String?
  returnedVariant   ProductVariant? @relation("DonenVaryant", fields: [returnedVariantId], references: [id], onDelete: SetNull)

  /// Mal gelip hüküm verilince doğan iade. Bire bir.
  returnId String? @unique
  return   Return? @relation(fields: [returnId], references: [id], onDelete: SetNull)

  /// Kim girdi. Geçmiş kayıt yok (tablo yeni) ama desen aynı kalsın.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// İadeden doğan tazminat talepleri (kargoda kaybolma, hasar).
  compensations Compensation[]

  @@index([saleId])
  @@index([status])
  @@index([noticedAt])
  @@index([reservedVariantId])
  @@index([userId])
  /// "Süresi dolmak üzere olanlar" sorgusu — panel çanı buradan besleniyor.
  @@index([otomatikOnayTarihi])
  @@index([islemSonTarihi])
}

/// ============================================================================
///  DOSYA EKİ — GENEL ALTYAPI
/// ----------------------------------------------------------------------------
///  İhtiyaç dört yerde AYNI: itiraz fotoğrafı · hasar fotoğrafı · alım
///  faturası · tazminat delili. Dördünü ayrı ayrı yazmak aynı işi dört kez
///  yapmaktır, bu yüzden tek model.
///
///  BAĞ POLİMORFİKTİR (foreign key YOK) — bilinçli. Dört ayrı nullable FK,
///  şemayı her yeni ek türünde büyütürdü. Bedeli: silinen kaydın ekleri
///  otomatik düşmez, temizlik uygulama katmanının işidir.
///
///  ⚠ DOSYALARIN KENDİSİ JSON YEDEĞE GİRMEZ (kullanıcı kararı 13.08.2026).
///  Telafi üçlüsü: (1) bu tablonun SATIRLARI yedekte, (2) yedeğe EK
///  MANİFESTİ eklenir (adet/boyut/blob yolları), (3) geri yükleme ekranı
///  "N ek bu dosyada yok, Blob'da" uyarısı gösterir.
///  Blob yedekleme stratejisi ayrı karar maddesi (BEKLEYENLER).
/// ============================================================================
model Attachment {
  id String @id @default(cuid())

  /// "ReturnNotice" | "Return" | "Purchase" | "Compensation" | "Talep"
  /// ENUM DEĞİL, düz string: hedef listesi `lib/ekler.ts`te tutuluyor ve
  /// `ekHedefiGecerliMi` ile doğrulanıyor. Yeni hedef eklemek migration
  /// GEREKTİRMEZ — yalnız o listeye yazılır.
  targetType String
  targetId   String

  /// Depodaki yol: ekler/<tip>/<id>/<dosya>
  blobPath  String
  fileName  String
  mimeType  String
  /// Sınır uygulama katmanında: dosya başına 5 MB, kayıt başına 10 ek.
  sizeBytes Int

  uploadedAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId])
  @@index([userId])
}

model ReturnItem {
  id       String @id @default(cuid())
  returnId String
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  variantId String
  variant   ProductVariant @relation("IadeVaryanti", fields: [variantId], references: [id], onDelete: Restrict)

  /// İade edilen toplam adet. Kısmi iade mümkündür.
  quantity Int

  /// Sağlam gelen — RETURN_IN ile stoğa girer.
  soundQuantity Int @default(0)

  /// HASARLI gelen — stoğa GİRMEZ, sayaç olarak tutulur.
  /// PurchaseItem.damagedQuantity ile aynı kalıp; tazminat süreci Faz 3.
  damagedQuantity Int     @default(0)
  damageNote      String? @db.Text

  /// Sağlam mal hangi rafa girdi.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  /// DEĞİŞİM: müşteriye yerine gönderilen varyant.
  /// Doluysa EXCHANGE_OUT hareketi oluşur (gelir yok, maliyet var).
  exchangeVariantId String?
  exchangeVariant   ProductVariant? @relation("DegisimVaryanti", fields: [exchangeVariantId], references: [id], onDelete: SetNull)

  stockMovements StockMovement[]
  fees           ReturnFee[]
  compensations  Compensation[]

  @@index([returnId])
  @@index([saleItemId])
  @@index([variantId])
  @@index([locationId])
  @@index([exchangeVariantId])
}

model ReturnFee {
  id       String @id @default(cuid())
  returnId String
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  /// Doluysa kalem etkisi, boşsa İADE GENELİ (kargo, ceza).
  returnItemId String?
  returnItem   ReturnItem? @relation(fields: [returnItemId], references: [id], onDelete: Cascade)

  /// Sözlükten Türkçe adı çözülen kod:
  /// KOMISYON_IADE, KOMISYON_KDV_IADE, ODEME_GIDERI_IADE, STOPAJ_IADE,
  /// KAYIP_GELIR, MALIYET_GERI, IADE_KARGO, YENIDEN_GONDERIM_KARGO,
  /// CEZA, DEGISIM_MALIYET
  code String
  name String?

  /// İşaret ANLAMLIDIR: pozitif = satıcıya geri gelen, negatif = gider.
  amount   Decimal  @db.Decimal(18, 4)
  currency Currency

  createdAt DateTime @default(now())

  @@index([returnId])
  @@index([returnItemId])
}

// ============================================================================
//  GİDER / MUHASEBE  (Faz 2 / Aşama 4)
// ----------------------------------------------------------------------------
//  İKİ KATMAN İLKESİ (kullanıcı kararı 10.08.2026):
//  Genel gider ÜRÜN kârının İÇİNE ASLA girmez. Ürün/satış seviyesi brüt kâr
//  (NET-1/NET-2) olarak kalır — alım/satış kararları brüt kârla verilir,
//  batık maliyet yanılgısı önlenir. Genel gider YALNIZCA firma/dönem
//  seviyesinde düşülür:
//
//      GERÇEK NET = Σ NET-2 (iadeler dahil) − dönem giderleri
//
//  Bu yüzden burada satış/ürün tarafına HİÇBİR bağ yoktur; olsaydı bir gün
//  biri "şu gideri şu ürüne dağıtalım" derdi ve ilke sessizce delinirdi.
// ============================================================================

model ExpenseCategory {
  id String @id @default(cuid())

  name String @unique

  /// Sabit gider mi (kira, maaş) yoksa değişken mi (sarf malzeme)?
  /// Dönem raporundaki gider dökümü bu ayrımla gruplanır.
  isFixed Boolean @default(false)

  /// Bu kategoriye yazılan giderin varsayılan KDV oranı (%).
  /// Maaş ve vergi gibi KDV'siz kalemlerde 0'dır; formda değiştirilebilir.
  defaultVatRate Decimal @default(20) @db.Decimal(5, 2)

  /// SİLİNMEZ, pasife alınır — geçmiş giderler kategorisiz kalmasın.
  isActive Boolean @default(true)

  /// Ekrandaki sıra. Aynı değerdeyse ada göre sıralanır.
  sortOrder Int @default(0)

  /// Formda çıkacak uyarı metninin sözlük anahtarı. Bugün tek kullanıcısı
  /// "Vergi": NET-2 ödenecek KDV'yi zaten düşüyor, KDV ödemesi buraya
  /// girilirse ÇİFT düşer. Metin koda gömülmez, sözlükten çözülür.
  warningKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses  Expense[]
  templates ExpenseTemplate[]

  @@index([isActive])
}

model Expense {
  id String @id @default(cuid())

  /// İŞ TARİHİ — giderin hangi döneme yazıldığı. Alım/satışla aynı kalıp:
  /// takvim günü, UTC gece yarısı. Kayıt zamanı `createdAt`tir, bu değil.
  spentAt DateTime

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// KDV DAHİL tutar — kâr motoruyla aynı kural (bkz. src/lib/kar.ts).
  amount   Decimal  @db.Decimal(18, 4)
  currency Currency

  /// Giderin KDV oranı (%). Kategoriden önerilir, elle değiştirilebilir.
  /// İNDİRİLEBİLİR sayılır: GERÇEK NET'ten düşen kısım tutarın KDV HARİÇ
  /// hâlidir, KDV toplamı raporda ayrı satır olur (kullanıcı kararı
  /// 10.08.2026). KDV'siz gider için 0 girilir → tam tutar düşer.
  vatRate Decimal @db.Decimal(5, 2)

  description String? @db.Text

  /// Tekrarlayan gider şablonundan kopyalandıysa kaynağı. "Bu ay eklendi mi?"
  /// kontrolü buradan yapılır — kira iki kez girilmesin.
  templateId String?
  template   ExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bu gider bir KART GECİKME FAİZİ karşılığıysa, doğduğu ödeme kaydı.
  /// Tekil: bir ödemenin faizi tek bir gidere yazılır.
  kartOdemesi KartOdeme?

  /**
   * GİDER HANGİ KARTLA ÖDENDİ (25.08.2026).
   *
   * ⚠ NİYE AÇILDI: kullanıcı _"giderleri ve vergileri de kartla ödüyorum,
   * bugün 4-5 binlik vergi ödedim"_ dedi. Kart borcu `kartBorcuHesapla`
   * ile YALNIZ alımlardan hesaplanıyordu; kartla ödenen gider borçta hiç
   * görünmüyor, kart borcu ve NAKİT TAKVİMİ o kadar eksik çıkıyordu.
   *
   * ⚠ `kartOdemesi` ALANIYLA KARIŞTIRILMAZ — o TERS yöndedir: kart
   * ekstresi ödenirken doğan gecikme faizini gidere bağlar. Bu alan ise
   * "bu gideri şu kartla ödedim" der ve karta BORÇ yazar.
   *
   * ⚠ ADLAR ALIMLA BİREBİR AYNI (`creditCardId` · `installmentCount`):
   * iki yerde iki farklı ad, iki farklı zihin modeli demekti. Aynı ad,
   * aynı anlam, aynı hesap (`BorcAlimi`).
   *
   * ⚠ MERDİVEN ÖLÇÜLDÜ, SÜTUNA EN SON GELİNDİ: ① mevcut alan taşımıyor
   * (`kartOdemesi` ters yönde) · ② serbest metin yetmez — borç hesabı
   * SORGU istiyor, geriye bakış değil · ③ türetilemez, hangi giderin
   * hangi kartla ödendiği hiçbir yerden çıkmıyor.
   */
  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  /**
   * Taksit sayısı. 1 = tek çekim.
   *
   * ⚠ İLK KARARDA "TAKSİT GEREK YOK" DENMİŞTİ, KULLANICI DÜZELTTİ ve
   * gerekçesi net: _"devlete peşin kartla ödüyorum, sonra banka
   * uygulamasına girip taksit seçeneği varsa böldürüyorum."_ Yani taksit
   * ödeme ANINDA değil, sonradan bankada seçiliyor — ama karta yansıyan
   * borç taksitli. Tek çekim varsayılsaydı borç yanlış aya yığılırdı.
   */
  installmentCount Int @default(1)

  /**
   * ÖDEME YÖNTEMİ — NAKİT | HAVALE | KART (25.08.2026).
   *
   * ⚠ `null` = BELİRTİLMEDİ. Alan açılmadan önceki giderler boş kalır ve
   * ekran "belirtilmedi" der; "Nakit" varsayılmaz.
   *
   * ⚠ `creditCardId` İLE TUTARLILIK UYGULAMA KATMANINDA BAĞLIDIR (zod):
   * KART seçiliyse kart zorunlu, KART değilse kart temizlenir. Veritabanı
   * kısıtıyla kurulmadı çünkü MySQL'de koşullu CHECK bakımı pahalı ve
   * `null` üçüncü bir hâl olarak kuralın dışında kalıyor.
   *
   * ⚠ HESABA GİRMEZ — borç `creditCardId`den yürür. Bu alan beyan/görünüm.
   */
  odemeYontemi OdemeYontemi?

  @@index([spentAt])
  @@index([categoryId])
  @@index([templateId])
  @@index([creditCardId])
}

// ============================================================================
//  KULLANICI — TEK KULLANICILI GİRİŞ (Faz 3,5)
// ----------------------------------------------------------------------------
//  10.08.2026'da canlıya çıkınca ortaya çıktı: sistemde hiç giriş yoktu ve
//  adres internete açıldı. Vercel'in ücretsiz koruması üretim adresini
//  kapsamıyor, özel alan adını ise kendi tanımıyla hariç tutuyor; ücretlisi
//  aylık 150 dolar. Bu yüzden kapı uygulamanın kendi içinde.
//
//  BURADA YETKİ (RBAC) YOK — bilerek. "Kim neyi görebilir" ayrımı tek
//  kullanıcıda boş katmandır; Faz 4'te çoklu kullanıcıyla birlikte gelir.
//  Bu model o gün rol alanı eklenerek büyür, yeniden yazılmaz.
//
//  PAROLA AÇIK SAKLANMAZ: yalnızca scrypt özeti ve tuzu tutulur.
//  scrypt Node'un içinde olduğu için yeni bağımlılık gerekmedi.
// ============================================================================

model User {
  id String @id @default(cuid())

  email String @unique

  /// scrypt özeti — biçim: `scrypt$N$r$p$tuz$ozet` (hepsi base64url).
  /// Ayarlar özetin İÇİNDE durur ki ileride maliyet artırılsa eski
  /// parolalar da doğrulanabilsin.
  passwordHash String @db.Text

  /// Görünen ad — üst çubukta ve çıkış menüsünde.
  name String?

  isActive Boolean @default(true)

  /// Bu değer artırılınca O KULLANICININ tüm oturumları geçersiz olur.
  /// "Her yerden çıkış yap" ve parola değişikliği bunu kullanır; jetonun
  /// içinde taşındığı için doğrulama veritabanına gitmeden yapılabilir.
  sessionVersion Int @default(1)

  /// SAHİP parola atar, kullanıcı İLK GİRİŞTE değiştirmek zorunda kalır.
  /// E-posta altyapısı yok (karar 13.08.2026): davet e-postası kurmak,
  /// çözdüğü sorundan büyük bir bağımlılık olurdu.
  mustChangePassword Boolean @default(false)

  lastLoginAt DateTime?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  stockMovements      StockMovement[]
  iadeler             Return[]
  iadeBildirimleri    ReturnNotice[]
  ekler               Attachment[]
  userCompanyRoles    UserCompanyRole[]
  auditLogs           AuditLog[]
  /// Bu kullanıcının açtığı destek talepleri.
  talepler            Talep[]           @relation("TalepBildiren")
  /// Bu kullanıcının yazdığı çözüm notları (Faz 2'de mesajlara evrilecek).
  talepCozumleri      Talep[]           @relation("TalepCozumYazani")
  /// Bu kullanıcının iptal ettiği satışlar.
  iptalEttigiSatislar Sale[]            @relation("SatisIptalEden")

  @@index([isActive])
}

// ============================================================================
//  TEDARİKÇİ · HAKEDİŞ · TAZMİNAT  (Faz 3)
// ============================================================================

/// Malı aldığınız firma. Tazminat bir tedarikçiye açılır; serbest metinle
/// "bu tedarikçiden toplam ne kadar alacağım var" sorusu cevaplanamazdı.
model Supplier {
  id String @id @default(cuid())

  name String @unique

  /// KİMLİK KISALTMASI — otomatik alım numarasının parçası (ALM-ER-260810-01).
  /// Kategori kodundaki kural aynen geçerli: çakışmada boş kalır, sorulur.
  code String? @unique

  /// Telefon / e-posta / kişi — serbest metin, tek alan yeter.
  contact String?
  note    String? @db.Text

  /// SİLİNMEZ, pasife alınır — geçmiş alımlar tedarikçisiz kalmasın.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases     Purchase[]
  compensations Compensation[]

  @@index([isActive])
}

// ----------------------------------------------------------------------------
//  HAKEDİŞ — "sattım, parayı ne zaman aldım?"
// ----------------------------------------------------------------------------
//  Kâr motoru satışın KAZANCINI biliyordu, TAHSİLATINI bilmiyordu. Hakediş
//  pazaryerinin yaptığı toplu ödemedir: bir dönemin siparişleri tek seferde
//  ödenir.
//
//  BEKLENEN tarih hesaplanır (satış + kanal hesabının vadesi),
//  GERÇEKLEŞEN ödeme pazaryeri hakediş raporundan içe aktarılır.
//  İkisinin farkı "bekleyen para" ve "geç/eksik ödeme" görünümünü verir.
// ----------------------------------------------------------------------------

model Settlement {
  id String @id @default(cuid())

  channelAccountId String
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Restrict)

  /// Pazaryerindeki hakediş/ödeme numarası — opsiyonel ama girilirse tekildir.
  code String?

  /// Paranın hesaba geçtiği gün.
  /// ZORUNLU DEĞİL: Trendyol raporunda gerçekleşen ödeme tarihi YOK,
  /// yalnız vade var. Tarihler artık kalemlerde tutuluyor.
  paidAt DateTime?

  /// Hakedişin kapsadığı dönem (rapordan okunur).
  periodStart DateTime?
  periodEnd   DateTime?

  /// Panelin bildirdiği TOPLAM ödeme. Kalem toplamıyla arasındaki fark
  /// ekranda gösterilir — sessizce eşitlenmez.
  amount   Decimal  @db.Decimal(18, 4)
  currency Currency

  /// İÇE AKTARMA PARTİSİ: bir yükleme = bir Settlement (kullanıcı kararı
  /// 11.08.2026). Tarihler kalemlerde durur, raporlama dinamik gruplar.
  /// Yüklenen dosyanın adı — hangi rapordan geldiğini görebilmek için.
  sourceFile String?

  note String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SettlementItem[]

  @@index([channelAccountId])
  @@index([paidAt])
}

/// Hakedişin hangi satışı kapsadığı. Bir satış birden çok hakedişte
/// görünebilir (kısmi ödeme), bu yüzden satış başına tekillik YOK.
/// Hakediş raporundan gelen TEK SATIR.
///
/// Hepsiburada UZUN format verir: bir siparişin sipariş tutarı, komisyonu,
/// kargosu, stopajı AYRI SATIRLARDIR. Bu yüzden "satış başına tek kalem"
/// kısıtı kaldırıldı — o kısıt HB raporunun ikinci satırını reddediyordu.
model SettlementItem {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  /// EŞLEŞMEYEN KALEM DE YAZILIR: rapordaki sipariş sistemde henüz yoksa
  /// satır kaybolmaz, `saleId` boş kalır ve uyarı listesinde görünür.
  /// Satış sonradan girilince bağlanabilir (kullanıcı kararı 11.08.2026).
  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  /// TEKİLLİK KAPSAMI. `settlementId` üzerinden de bulunabilirdi ama o zaman
  /// aynı Kayıt No İKİNCİ bir partiyle tekrar yüklenebilirdi. İdempotentlik
  /// kanal hesabı düzeyinde olmalı, parti düzeyinde değil.
  channelAccountId String
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Restrict)

  /// Pazaryerinin "Kayıt No"su — HEPSİBURADA'DA BU BİR FATURA NUMARASIDIR
  /// (EFA2026000000101) ve o faturanın TÜM kalemleri aynı numarayı taşır.
  /// Bu yüzden TEK BAŞINA TEKİL DEĞİLDİR; ekranda "Fatura/Kayıt No" diye
  /// etiketlenir ki kullanıcı HB panelindeki faturayla eşleştirebilsin.
  /// Ölçüm 11.08.2026: 539 satır, yalnız 94 farklı Kayıt No.
  externalId String

  /// İDEMPOTENTLİĞİN GERÇEK ANAHTARI: externalId | siparişNo | HAM TİP.
  /// Ölçülen tekil kombinasyon (HB 539/539, TY 298/298).
  ///
  /// ⚠ HAM TİPTEN üretilir, normalleştirilmiş `code`tan DEĞİL: iki farklı
  /// tanınmayan tip aynı siparişe düşünce ikisi de DIGER olur; koddan
  /// üretilseydi biri sessizce kaybolurdu. KARAR KALICI.
  rowKey String

  /// Ortak kalem kodu (KOMISYON, KARGO, STOPAJ...). Pazaryerinin kendi
  /// metni `rawType`'ta durur; tanınmayan tip DIGER olur ama metni kalır.
  code    String
  rawType String?

  /// Ham sipariş numarası — eşleşmese bile saklanır ki sonradan bağlanabilsin.
  orderNo String?

  /// Gelir POZİTİF, gider NEGATİF. İşaret okuyucuda tekleştirilir.
  amount   Decimal  @db.Decimal(18, 4)
  currency Currency

  /// Vade: paranın ne zaman ödeneceği. Ödeme: ne zaman ödendiği.
  /// `paidAt` boşsa kalem BEKLEYEN paradır.
  dueDate DateTime?
  paidAt  DateTime?

  /// Kaynağa dönmek gerekirse: ham satırın okunur özeti.
  rawRow String? @db.Text

  createdAt DateTime @default(now())

  @@unique([channelAccountId, rowKey])
  @@index([externalId])
  @@index([settlementId])
  @@index([saleId])
  @@index([orderNo])
  @@index([dueDate])
}

// ----------------------------------------------------------------------------
//  TAZMİNAT — hasarlı gelen mal için tedarikçiden alacak
// ----------------------------------------------------------------------------

model Compensation {
  id String @id @default(cuid())

  /**
   * ══════════════════════════════════════════════════════════════════════
   * KARŞI TARAF ÜÇ TÜRDEN BİRİ OLABİLİR (23.08.2026)
   * ----------------------------------------------------------------------
   * Bu tablo "tedarikçiden tazmin" için yazılmıştı ve `supplierId`
   * ZORUNLUYDU. İade süreci ölçülünce iki karşı taraf daha çıktı
   * (docs/iade-sureci.md):
   * · KARGO ŞİRKETİ — iade 10 günde ulaşmazsa pazaryeri sebebi ne olursa
   * olsun onaylıyor, para gidiyor; tazmin kargodan istenir (§12.1).
   * · PAZARYERİ — HB'de servis dalı "Hurda Geliri" ile bitiyor (§11.4).
   * ⚠ Pazaryerleri ZATEN `Supplier` listesinde (arbitrajda onlardan da
   * alım yapılıyor), yani o taraf ek alan GEREKTİRMEDİ.
   * ⚠ KARGO FİRMALARI İKİNCİ KEZ `Supplier` OLARAK AÇILMADI. Aynı varlığın
   * iki kimliği olur ve bir gün ayrışırlar — Soundcore vakasının aynısı
   * (`194645027819` vs `194644037819`: benzer ad, farklı kimlik, iki ayrı
   * hüküm). `CargoCarrier` zaten var (12 kayıt: ARAS · YURTICI · HEPSIJET…)
   * ve kargo tarifesi ondan okunuyor; tazminat da ondan okur.
   * ⚠ ÜÇÜ DE BOŞ BİR KAYIT ANLAMSIZDIR. Prisma bunu ifade edemiyor
   * ("en az biri dolu" diye bir kısıt yok), bu yüzden kural UYGULAMA
   * KATMANINDA duruyor.
   * ══════════════════════════════════════════════════════════════════════
   */
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  /// Karşı taraf kargo şirketiyse. `Supplier` DEĞİL — bkz. yukarıdaki not.
  carrierId String?
  carrier   CargoCarrier? @relation(fields: [carrierId], references: [id], onDelete: Restrict)

  /// Hangi alım kalemindeki hasar. Silinirse talep kaydı kalır.
  purchaseItemId String?
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)

  /// HASARIN İKİNCİ KAYNAĞI: müşteriden hasarlı dönen iade kalemi.
  /// Mal kabulde hasarlı çıkan da, müşteriden kırık dönen de tedarikçiye
  /// yazılabilir; ikisi ayrı alanda durur çünkü ayrı sorunun cevabıdır
  /// ("mal bize bozuk geldi" vs "müşteriye bozuk gitmiş").
  /// Bir talep ya alım kalemine ya iade kalemine bağlanır, ikisine değil.
  returnItemId String?
  returnItem   ReturnItem? @relation(fields: [returnItemId], references: [id], onDelete: SetNull)

  /**
   * HASARIN ÜÇÜNCÜ KAYNAĞI: iade BİLDİRİMİ.
   * ⚠ `returnItemId` BU VAKADA İŞE YARAMIYOR. Kargoda kaybolan iadede
   * `Return` HİÇ DOĞMUYOR (mal gelmedi, hüküm verilmedi) — dolayısıyla
   * `ReturnItem` de yok ve bağlanacak bir şey kalmıyor. Oysa tam o anda
   * bir ALACAK doğuyor. Bağ bir aşama yukarıya, bildirime kuruluyor.
   */
  returnNoticeId String?
  returnNotice   ReturnNotice? @relation(fields: [returnNoticeId], references: [id], onDelete: SetNull)

  /// Talebe konu adet.
  quantity Int

  /// Talep edilen tutar.
  amount   Decimal  @db.Decimal(18, 4)
  currency Currency

  status     CompensationStatus @default(OPEN)
  occurredAt DateTime
  note       String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([purchaseItemId])
  @@index([returnItemId])
  @@index([carrierId])
  @@index([returnNoticeId])
}

/// Tekrarlayan gider ŞABLONU — gider DEĞİLDİR, hiçbir toplama girmez.
///
/// AYRI TABLO OLMASI BİLİNÇLİ: aynı tabloda `isTemplate` bayrağı olsaydı, o
/// filtreyi bir yerde unutan her sorgu rapora hayalet gider yazardı. Aynı
/// gerekçeyle ReturnFee de SaleFee'den ayrılmıştı. Ayrı tablo bunu yapısal
/// olarak imkânsız kılar.
///
/// OTOMATİK KAYIT ÜRETMEZ. Kullanıcı her ay "bu ay için ekle" der; sistem
/// kendiliğinden gider yazmaz (kullanıcı kararı 10.08.2026).
model ExpenseTemplate {
  id String @id @default(cuid())

  /// "Ofis kirası", "Muhasebeci ücreti"
  name String

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  amount   Decimal  @db.Decimal(18, 4)
  currency Currency
  vatRate  Decimal  @db.Decimal(5, 2)

  description String? @db.Text

  /// Ayın kaçında ödenir (1-31). Kopyalarken tarihi önerir; boş olabilir.
  dayOfMonth Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([isActive])
}

// ============================================================================
//  STOK DÜZELTME NEDENİ
// ----------------------------------------------------------------------------
//  Kırılma, kayıp, fire, sayım farkı... Neden VERİDİR, sabit kod değil:
//  SaaS'ta her müşteri kendi fire nedenlerini tanımlayacak. ExpenseCategory
//  deseninin aynısı — silinmez, pasife alınır; geçmiş hareketler nedensiz
//  kalmasın.
// ============================================================================

model StockAdjustmentReason {
  id String @id @default(cuid())

  name String @unique

  /// SİSTEM ANAHTARI — kod bu nedeni adıyla DEĞİL bununla bulur.
  /// Ad kullanıcıya aittir ve "Neden yönetimi" ekranından değiştirilebilir;
  /// koda ad gömseydik kullanıcı adı düzelttiği an sevkiyat hatası düzeltmesi
  /// sessizce çalışmaz olurdu. Elle açılan nedenlerde null'dur.
  /// Bugünkü tek değer: "SEVKIYAT_HATASI" (yanlış ürün gönderimi).
  systemKey String? @unique

  /// Bu neden hangi hareket tipini yazar.
  /// COUNT_CORRECTION (sayım farkı) ile ADJUSTMENT (kırılma/kayıp) ayrı
  /// tiplerdir ve raporda AYRI satırlarda görünürler: sayım farkı ölçüm
  /// hatasıdır, fire gerçek kayıptır.
  movementType StockMovementType @default(ADJUSTMENT)

  /// Bu neden hangi YÖNDE seçilebilir.
  ///
  /// VARSAYILAN `HER_IKISI`: mevcut kayıtlar ve kullanıcının kendi açtığı
  /// nedenler davranış DEĞİŞTİRMEZ — migration hiçbir satırı kısıtlamaz.
  /// Daraltma sonradan, seed ile ve bilinçli olarak yapılır.
  yon DuzeltmeYonu @default(HER_IKISI)

  /// Açıklama girmek zorunlu mu? "Diğer" nedeninde açıklamasız kayıt,
  /// üç ay sonra cevapsız bir soruya dönüşür.
  requiresNote Boolean @default(false)

  /// SİLİNMEZ, pasife alınır.
  isActive Boolean @default(true)

  /// Ekrandaki sıra. Aynı değerdeyse ada göre sıralanır.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@index([isActive])
}

// ============================================================================
//  YETKİ (RBAC) VE ÇOK FİRMA HAZIRLIĞI
// ----------------------------------------------------------------------------
//  Karar 13.08.2026. İki hedef aynı pakette:
//
//  1. BUGÜN: TR ekibi sisteme girecek. İki rol (SAHİP, OPERASYON), sayfa ve
//     işlem bazlı izin. Roller VERİDİR — enum değil; ekip büyüyünce yeni rol
//     ekrandan türetilir.
//
//  2. YARIN: sistem TEK GİRİŞ + ÇOK FİRMA olacak (tipik ERP). Yapı buna
//     HAZIR doğuyor ama tam çok-kiracılık BUGÜN YAPILMIYOR: kullanıcı role
//     doğrudan değil ÜYELİK üzerinden bağlanıyor. Bugün tek firma olduğu
//     için davranış birebir aynı; yarın aynı kullanıcı başka firmada başka
//     rol taşıyabilir ve tek satır bile yeniden yazılmaz.
//
//     companyId'nin diğer 30 tabloya yayılması AYRI PAKETTİR
//     (bkz. BEKLEYENLER → çok-firma veri katmanı).
//
//  İZİN ANAHTARLARI KOD SABİTİDİR, VERİ DEĞİL: "alim.yaz" ancak o kodu
//  koruyan bir satır varsa anlamlıdır. Rol veridir, izin listesi değil.
// ============================================================================

/// Firma. Bugün TEK kayıt (seed) — çok firma yapısının çıpası.
model Company {
  id String @id @default(cuid())

  name String
  /// Kimlik standardındaki kod (bkz. lib/kimlik.ts).
  code String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * MENÜ DÜZENİ — SIRA VE GRUPLAMA, JSON METİN (K51, 25.08.2026).
   *
   * ⚠ NİYE AÇILDI: menü sırası ÜÇ KEZ koddan değişti (22.08 yedi kalem ·
   * 25.08 `Paketle` · 25.08 kullanıcı sırayı birebir verdi). Her seferinde
   * iki dosya elden geçti, bir bekçi sınırı elle artırıldı ve bir deploy
   * beklendi. Sıralamak bir KOD işi değildir.
   *
   * ⚠ MERDİVEN ÖLÇÜLDÜ, SÜTUNA EN SON GELİNDİ:
   *   ① Mevcut alan: `Company`de serbest metin YOK (ölçüldü, 6 kolon). ✗
   *   ② `AuditLog`: current-state deposu DEĞİL — menü HER RENDER'da
   *      okunuyor, `ORDER BY createdAt DESC LIMIT 1` gerekirdi ve o tablo
   *      "geriye bakmak" için (232 satır, sürekli büyüyor). ✗
   *   ③ Türetilebilir mi: hayır, tercih. ✗
   *   ④ SÜTUN ✓ — ve YENİ TABLO DEĞİL: mevcut tabloya tek nullable metin.
   *
   * ⚠ FİRMA DÜZLEMİNDE, KULLANICI DÜZLEMİNDE DEĞİL. Menü sırası bir
   * operasyon standardıdır ("herkes aynı menüyü görsün"); kullanıcının
   * göremeyeceği ekranları zaten RBAC gizliyor. İleride kişisel tercih
   * istenirse `User.menuDuzeni` ÜSTTE ezen bir katman olarak eklenir —
   * bu sütun kaldırılmaz.
   *
   * ⚠ `null` = KULLANICI HİÇ DÜZENLEMEDİ. Varsayılan düzen koddadır ve
   * bu bir eksiklik değildir.
   *
   * ⚠ SORGULANMAZ, BÜTÜN OKUNUR: indeks yok (firma PK ile geliyor) ve
   * JSON şeması yok. Bu veri gruplanmıyor, toplanmıyor, süzülmüyor —
   * bir kerede okunup bir kerede yazılıyor. Sorgu ihtiyacı doğduğu gün
   * yapı kararı yeniden verilir.
   *
   * ⚠ BİÇİM V2'Yİ TAŞIR: grup kaydı isteğe bağlı `ad` alanı kabul eder
   * (kullanıcının açtığı grubun adı). V1 yazmıyor, ama reddetmiyor —
   * böylece V2 bir göç değil GENİŞLEME olur.
   */
  menuDuzeni String? @db.Text

  uyelikler UserCompanyRole[]
  auditLogs AuditLog[]
  talepler  Talep[]

  @@index([isActive])
}

/// Rol — FİRMA BAĞIMSIZ. İzin tanımları ortaktır, atama üyelikte yapılır.
model Role {
  id String @id @default(cuid())

  name String @unique

  /// Sistem rolü SİLİNEMEZ ve pasife alınamaz (SAHİP).
  /// Ada bakarak korumak kırılgandı: kullanıcı adı "Patron" yapabilir.
  isSystem Boolean @default(false)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  izinler   RolePermission[]
  uyelikler UserCompanyRole[]

  @@index([isActive])
}

/// Rolün sahip olduğu izin. Anahtar KODDAN gelir (lib/yetki/izinler.ts).
model RolePermission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  /// "alim.yaz", "rapor.gor" gibi. Kod sabiti; veritabanı doğrulamaz,
  /// uygulama tanımadığı anahtarı YOK SAYAR ve denetim betiği bildirir.
  permissionKey String

  createdAt DateTime @default(now())

  @@unique([roleId, permissionKey])
  @@index([roleId])
}

/// ÜYELİK: kullanıcı + firma + rol. Kullanıcı role DOĞRUDAN bağlanmaz.
model UserCompanyRole {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  roleId String
  /// Restrict: kullanımdaki rol silinemez. Roller zaten silinmez, pasife
  /// alınır — bu kısıt o kuralın veritabanı tarafındaki karşılığıdır.
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bir kullanıcının bir firmada TEK rolü olur.
  @@unique([userId, companyId])
  @@index([companyId])
  @@index([roleId])
}

/// DENETİM İZİ — ledger'a girmeyen ama "kim yaptı" bilinmesi gereken işler.
/// Geri yükleme, dışa aktarma, yedek indirme, kullanıcı/rol değişikliği.
/// Dışa aktarma özellikle: tüm veriyi indirmek sessiz kalmamalı.
model AuditLog {
  id String @id @default(cuid())

  /// Kim. Kullanıcı silinmez (pasife alınır), bu yüzden Restrict.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /// Ne yapıldı: "GERI_YUKLEME", "DISA_AKTARMA", "YEDEK_INDIRME",
  /// "KULLANICI_DEGISTI", "ROL_DEGISTI". Kod sabiti, sözlükten çözülür.
  action String

  /// Neye yapıldı — kayıt tipi ve kimliği (varsa).
  targetType String?
  targetId   String?

  /// Serbest ayrıntı: kaç satır yazıldı, hangi dosya, eski/yeni rol...
  detail String? @db.Text

  /// Nereden. Vekil sunucu arkasında güvenilmez olabilir; bilgi amaçlı.
  ip String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

/// Talep türü — kullanıcının ne bildirdiği.
///
/// İKİ TÜR YETER: "hata" (çalışmıyor) ile "istek" (olsun isterim) farklı
/// aciliyet ve farklı iş demektir. Üçüncü bir tür (soru, öneri) bugün
/// karşılığı olmayan bir ayrım olurdu — erken özellik yasak.
enum TalepTuru {
  HATA
  ISTEK
}

/// Talebin yaşam döngüsü.
///
/// AXCALI kendi talebinin DURUMUNU görür ama DEĞİŞTİREMEZ (`destek.yonet`
/// geliştiricide). "Kör kutuya attım" hissi bu yüzden doğmuyor: bildirdiği
/// şeyin nerede olduğunu takip edebiliyor.
enum TalepDurumu {
  ACIK
  INCELENIYOR
  YAPILIYOR
  COZULDU
  KAPANDI
  REDDEDILDI
  ERTELENDI
}

/// ============================================================================
///  DESTEK / TALEP — Faz 1
/// ----------------------------------------------------------------------------
///  Mimar sözleşmesi 15.08.2026. AXCALI eksik ve taleplerini Telegram'dan
///  dağınık iletiyordu; kayıt kalmıyor, durum takip edilemiyordu.
///
///  EKLER AYRI TABLO DEĞİL: mevcut `Attachment` polimorfik olarak kullanılır
///  (`targetType = "Talep"`). RMA'nın boyut/tür sınırları aynen geçerli —
///  ikinci bir ek altyapısı doğmasın.
///
///  DIŞ BİLDİRİM YOK (Telegram/e-posta): geliştirici Selliora'ya girip bakar.
///  Faz 2'de eklenebilir; mimari hazır kalıyor.
/// ============================================================================
model Talep {
  id String @id @default(cuid())

  /// Ekranda ve listede gösterilen kısa numara (TLP-0001).
  kod String @unique

  tur   TalepTuru
  durum TalepDurumu @default(ACIK)

  baslik   String @db.VarChar(191)
  aciklama String @db.Text

  /// ── OTOMATİK YAKALANAN BAĞLAM ──────────────────────────────────────────
  /// Kullanıcı "şurada olmuyor" derken hangi ekranda olduğunu yazmak zorunda
  /// kalmasın diye toplanır. NE YAKALANDIĞI FORMDA GÖRÜNÜR — gizli toplama
  /// izlenimi bırakılmaz (mimar şartı 16.08.2026).
  /// Bildirimin yapıldığı sayfa (pathname + sorgu).
  rota     String? @db.VarChar(500)
  /// Tarayıcı/cihaz kimliği — "yalnız telefonda oluyor" ayrımı için.
  tarayici String? @db.VarChar(500)

  /// ── TALEBİ AÇAN FİRMA ──────────────────────────────────────────────────
  /// Destek veren taraf GELİŞTİRİCİDİR (`destek.yonet`); açan taraf müşteri
  /// firmadır. Bugün tek firma var ama bu alan olmadan ikinci firma geldiği
  /// gün talepler birbirine karışır ve AXCALI başka firmanın talebini
  /// OKUR — sonradan düzeltilmesi zor bir sızıntı.
  ///
  /// Anayasa: "yeni yazılan hiçbir özellik tek firma varsayımını
  /// DERİNLEŞTİRMEMELİ." Çok-kiracılılığı bugün kurmuyoruz; yalnız onu
  /// ileride zorlaştıracak kısayoldan kaçınıyoruz.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  /// Bildiren kullanıcı. SİLİNMEZ: kullanıcı pasife alınsa da talep kalır.
  bildirenId String
  bildiren   User   @relation("TalepBildiren", fields: [bildirenId], references: [id], onDelete: Restrict)

  /// ── GELİŞTİRİCİNİN CEVABI — kullanıcı okur, yazamaz ────────────────────
  ///
  /// FAZ 2'DE MESAJ DİZİSİNE EVRİLECEK (mimar vizyonu 16.08.2026). Bugün
  /// tek not; yarın `TalepMesaj[]`. Geçiş YENİDEN YAZIM değil, temiz bir
  /// göç olmalı:
  ///
  ///   INSERT INTO TalepMesaj (talepId, gonderenId, gonderenTipi, metin, createdAt)
  ///   SELECT id, bildirenId,        'MUSTERI',      aciklama,  createdAt        FROM Talep;
  ///   SELECT id, cozumNotuYazanId,  'GELISTIRICI',  cozumNotu, cozumNotuZamani  FROM Talep
  ///     WHERE cozumNotu IS NOT NULL;
  ///
  /// Bu SELECT'in çalışabilmesi için notun YAZARI ve ZAMANI bugünden
  /// tutulmalı. `updatedAt` işe yaramaz: her durum değişikliğinde ezilir
  /// ve notun ne zaman yazıldığını değil kaydın en son ne zaman
  /// dokunulduğunu söyler.
  cozumNotu String? @db.Text

  /// Notu yazan geliştirici. Faz 2'de mesajın `gonderenId`si olacak.
  cozumNotuYazanId String?
  cozumNotuYazan   User?   @relation("TalepCozumYazani", fields: [cozumNotuYazanId], references: [id], onDelete: Restrict)

  /// Notun YAZILDIĞI an. Faz 2'de mesajın `createdAt`i olacak.
  cozumNotuZamani DateTime?

  /// Durum COZULDU/KAPANDI'ya geçtiği an.
  kapatilmaZamani DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([durum])
  @@index([tur])
  @@index([bildirenId])
  @@index([createdAt])
}

/// ============================================================================
///  GEÇMİŞ KART EKSTRESİ — BEYAN VERİSİ
/// ----------------------------------------------------------------------------
///  Mimar kararı 16.08.2026, dosya incelemesi sonrası.
///
///  NEDEN AYRI TABLO: canlı ekstreler ALIMLARDAN TÜRETİLİR (`kart-borcu.ts`),
///  saklanmaz. Geçmişte alım kaydı YOK (en eski alım 13.01.2026) ama kart
///  ekstreleri Mayıs 2025'e kadar gidiyor. Türetme motoruna beyan verisi
///  karıştırılsaydı iki farklı ekstre kavramı doğar ve biri diğerini
///  gölgelerdi.
///
///  KAPSAM KÜÇÜLDÜ: sözleşmedeki "iki tablo" bire indi. Hakediş sayfası
///  kapsamdan DÜŞTÜ — dosyada geçmiş hakediş yok, yalnız cari Tem-Ağu 2026
///  var ve o dönem sistemde zaten 651 `SettlementItem` olarak duruyor;
///  aktarmak çift sayım olurdu.
///
///  ⚠ ÇİFT SAYIM GİRİŞTE ENGELLENİR: `@@unique([cardId, donem])` bir kart
///  için bir ayda TEK beyan bırakır. Aynı dönemde TÜRETİLEN ekstre de varsa
///  TÜRETİLEN KAZANIR (gerçek alımlardan gelir) ve beyan uyarıyla atlanır —
///  kural uygulama katmanında, bu kısıt son emniyet kemeri.
/// ============================================================================
model GecmisEkstre {
  id String @id @default(cuid())

  cardId String
  card   CreditCard @relation(fields: [cardId], references: [id], onDelete: Restrict)

  /// Ekstre dönemi — ayın 1'i. `KartOdeme.donem` ile AYNI sözleşme;
  /// eşleme iki tarafta da yıl-ay üzerinden yapılır (bkz. donemAnahtari).
  donem DateTime

  /// Beyan edilen ekstre borcu (Excel: "Borç").
  borc     Decimal  @db.Decimal(18, 4)
  currency Currency @default(TRY)

  /// Excel: "Ödenen miktar" ve "Tarih". İkisi de boş olabilir — beyan
  /// edilmiş ama ödenmemiş ekstre gerçek bir durumdur.
  odenenTutar Decimal?  @db.Decimal(18, 4)
  odemeTarihi DateTime?

  kaynak VeriKaynagi @default(GECMIS_EXCEL)

  /// ── İZLENEBİLİRLİK ────────────────────────────────────────────────────
  /// Excel'deki HAM dönem metni ("Mayis", "MAyıs", "temmuz"). Ay adları
  /// tutarsız yazılmış; normalleştirilen değerin yanında ham hâli de
  /// durursa "bu satır neydi" sorusu sonradan cevaplanabilir.
  hamDonemMetni String? @db.VarChar(100)

  /// Yükleme partisi kodu — TOPLU GERİ ALMA için.
  ///
  /// Bir içe aktarma 160 satır yazıyor; parti kimliği OLMADAN yanlış bir
  /// aktarımı geri almak tek tek silmek demektir. Alan SONRADAN eklenirse
  /// ilk aktarımın satırları partisiz kalır ve tam da geri alınması
  /// gereken küme geri alınamaz. (Ders 16.08.2026: ileri uyumluluk iddiası
  /// gerçek senaryoyla sınanır.)
  iceAktarimKodu String? @db.VarChar(40)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bir kart için bir ayda TEK beyan — çift aktarım kırılır.
  @@unique([cardId, donem])
  @@index([donem])
  @@index([iceAktarimKodu])
}

/// ============================================================================
///  KOMİSYON TARİFESİ — DİLİMLİ ORAN, GEÇERLİLİK PENCERESİYLE
/// ----------------------------------------------------------------------------
///  ⚠ NİYE VAR — 18.08.2026 ölçümü. Trendyol'un komisyon dosyası ürün başına
///  TEK oran değil, **dört dilimli bir tarife** taşıyor: her fiyat aralığının
///  kendi komisyonu var (örn. ≥769,99 → %18 · 701,29–769,98 → %12,8 ·
///  641,09–701,28 → %11,1 · ≤641,08 → %9,3). Mekanizma açık: **fiyatı
///  düşürene komisyon indirimi.**
///
///  Bugün `ChannelSku.commissionRate` bu bilginin yalnız bir hücresini
///  saklıyor (fiyatın düştüğü dilimin oranı) ve gerisini atıyor. Fiyatlama
///  aracı "bir dilim aşağı insem ne olur" sorusunu ancak tam tarifeyle
///  cevaplayabilir.
///
///  ── PENCERE NİYE ŞART ───────────────────────────────────────────────────
///  Tarifenin ömrü var: dosyadaki hücre "14 Ağustos 08.00 – 18 Ağustos 07.59"
///  diyor. TY haftada İKİ kez yayımlıyor (Salı 08:00→Cuma 07:59 ve Cuma
///  08:00→Salı 07:59). Penceresiz bir "güncel oran" kavramı yarımdır: hangi
///  tarifeye ait olduğu bilinmeyen oranın bayat mı taze mi olduğu söylenemez.
///
///  Ayrıca bugünkü `commissionUpdatedAt` damgası "DEĞİŞTİ" demektir,
///  "DOĞRULANDI" değil — oranı aynı çıkan satır yazma planına hiç girmiyor
///  (`komisyon/plan.ts` → `ayniKalan`). Pencere kaydı bunu çözer: yükleme,
///  hiçbir oran değişmese bile pencere bırakır.
/// ============================================================================
model KomisyonTarifesi {
  id               String         @id @default(cuid())
  channelAccountId String
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Restrict)

  /// Tarifenin geçerlilik penceresi — dosyadaki hücreden çözülür.
  pencereBaslangic DateTime
  pencereBitis     DateTime

  /// Dosyadaki `TARİFE GRUBU` — ölçüldü: dosya başına TEK değer, yani
  /// ürün grubu değil DOSYA/tarife kimliği.
  tarifeGrubu String?

  /// Arşivdeki dosyanın adı — "kaynakta ne vardı" izlenebilsin.
  kaynakDosyaAdi String?

  /// ⚠ AYNI PENCERE İKİNCİ KEZ YÜKLENİRSE: ÜZERİNE YAZILIR (kalemler
  /// silinip yeniden kurulur), REDDEDİLMEZ. Gerekçe: bir pencerenin
  /// tarifesi kanalın YAYIMLADIĞI BİR OLGUDUR; aynı pencerenin iki
  /// yüklemesi aynı içeriğe yakınsamalıdır. Reddetseydik ilk yükleme
  /// eksik/bozuk geldiğinde düzeltmenin tek yolu elle silmek olurdu.
  /// Ledger dokunulmazlığı burada geçerli DEĞİL: bu referans veridir,
  /// hareket kaydı değil.
  ///
  /// Ama sessiz olmaz — kaçıncı yükleme olduğu ve son yükleme anı yazılır.
  yuklemeSayisi Int      @default(1)
  yuklendiAt    DateTime @default(now())

  kalemler KomisyonTarifeKalemi[]

  /// Bu tarifeden oran snapshot'lamış satış kalemleri.
  satisKalemleri SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bir hesap + bir pencere = TEK tarife.
  @@unique([channelAccountId, pencereBaslangic])
  @@index([pencereBitis])
}

/// Tarifenin tek satırı: bir ürünün BİR dilimi.
model KomisyonTarifeKalemi {
  id       String           @id @default(cuid())
  tarifeId String
  tarife   KomisyonTarifesi @relation(fields: [tarifeId], references: [id], onDelete: Cascade)

  /// HAM KİMLİK — dosyadan geldiği gibi. Eşleşme kurulamasa bile kalem
  /// SAKLANIR; bağsızlık sessiz kalmaz, yükleme raporunda sayısıyla yazar.
  /// _Hakediş 648 dersinin tekrarı olmasın (18.08.2026)._
  barkod         String
  saticiStokKodu String?
  urunAdi        String?

  /// Eşleşen varyant. NULL = bağ kurulamadı; kalem yine de duruyor.
  /// ⚠ EŞLEŞME ANAHTARI BARKOD: ölçüldü, 161 satırda 160 farklı barkod
  /// varken `SATICI STOK KODU` yalnız 98 farklı değer taşıyor ve boş
  /// olanlar var.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// 1..4 — dosyadaki dilim sırası. 1 en pahalı dilim (üst uç açık).
  dilimSirasi Int

  /// Dilimin sınırları. NULL = o uç AÇIK: 1. dilimin üstü, son dilimin altı.
  altLimit Decimal? @db.Decimal(18, 4)
  ustLimit Decimal? @db.Decimal(18, 4)

  /// Yüzde olarak oran (%12,8 -> 12.80) — `ChannelSku.commissionRate` ile
  /// aynı birim.
  oran Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  /// Mükerrer satır tekilleşir — ölçüldü: dosyada 1 barkod iki kez, iki
  /// satır BİREBİR aynı. "İki dilim" sanılmamalı.
  @@unique([tarifeId, barkod, dilimSirasi])
  @@index([variantId])
  @@index([barkod])
}
